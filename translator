function retryFailedChapters() {
  let retried = 0;
  S.epub.chapters.forEach((ch, i) => {
    // Retry if: status is 'err', or status is 'done' but output failed validation
    const shouldRetry = ch.status === 'err' ||
      (ch.status === 'done' && !isValidChunkOutput(ch.out, ch.raw));
    if (shouldRetry && S.epub.sel.has(i)) {
      ch.status = 'pending';
      ch.err = null;
      retried++;
    }
  });
  if (retried === 0) { lg('i', 'No failed chapters to retry'); return; }
  lg('i', `Marked ${retried} chapter(s) for retry`);
  renderEpQ(); renderEpList();
  runEpQ(); // kick off translation
}

