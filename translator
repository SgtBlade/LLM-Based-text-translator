function exportTranslated(format) {
  const done = S.epub.chapters.filter(c => c.status === 'done' && c.out);
  if (!done.length) { lg('w', 'No translated chapters to export'); return; }

  const title = S.epub.meta?.titleEn || S.epub.meta?.title || 'Translated Novel';
  let output = '';
  const safeName = title.replace(/[^a-z0-9]/gi, '_').slice(0, 60).toLowerCase();

  if (format === 'md') {
    output = `# ${title}\n\n`;
    done.forEach(ch => {
      output += `## ${ch.titleEn || ch.title}\n\n`;
      output += ch.out.split(/\n{2,}/).map(p => p.trim()).filter(p => p).join('\n\n');
      output += '\n\n---\n\n';
    });
    dlBlob(output, safeName + '.md', 'text/markdown');
    lg('o', `Exported ${done.length} chapter(s) as Markdown`);

  } else if (format === 'txt') {
    output = title + '\n' + '='.repeat(title.length) + '\n\n';
    done.forEach(ch => {
      output += (ch.titleEn || ch.title) + '\n' + '-'.repeat(20) + '\n\n';
      output += ch.out.split(/\n{2,}/).map(p => p.trim()).filter(p => p).join('\n\n');
      output += '\n\n\n';
    });
    dlBlob(output, safeName + '.txt', 'text/plain');
    lg('o', `Exported ${done.length} chapter(s) as plain text`);

  } else if (format === 'html') {
    const chapters = done.map(ch => {
      const paras = ch.out.split(/\n{2,}/).map(p =>
        `<p>${escXml(p.trim())}</p>`
      ).filter(p => p !== '<p></p>').join('\n');
      return `<section>\n<h2>${escXml(ch.titleEn || ch.title)}</h2>\n${paras}\n</section>`;
    }).join('\n\n');
    output = `<!DOCTYPE html>
