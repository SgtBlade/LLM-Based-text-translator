// ─── INPAINTING ───
function wt_sampleBg(r) {
  const ctx=S.wt.ctx, pad=5, pixels=[];
  const W=S.wt.cv.width, H=S.wt.cv.height;
  // Sample all 4 edges around the region (outside by pad px)
  for(let x=r.x;x<r.x+r.w;x+=3){
    let d=ctx.getImageData(x,Math.max(0,r.y-pad),1,1).data; pixels.push([d[0],d[1],d[2]]);
    d=ctx.getImageData(x,Math.min(H-1,r.y+r.h+pad),1,1).data; pixels.push([d[0],d[1],d[2]]);
  }
  for(let y=r.y;y<r.y+r.h;y+=3){
    let d=ctx.getImageData(Math.max(0,r.x-pad),y,1,1).data; pixels.push([d[0],d[1],d[2]]);
    d=ctx.getImageData(Math.min(W-1,r.x+r.w+pad),y,1,1).data; pixels.push([d[0],d[1],d[2]]);
  }
  if(!pixels.length) return [255,255,255];
  return pixels.reduce((a,b)=>[a[0]+b[0],a[1]+b[1],a[2]+b[2]],[0,0,0]).map(v=>Math.round(v/pixels.length));
}

function wt_inpaint(r) {
  const ctx=S.wt.ctx, mode=S.wt.inpaint;
  if(mode==='a1111'){wt_inpaintA1111(r);return;}
  const [ri,gi,bi]=wt_sampleBg(r);
  if(mode==='blur') {
    // Radial gradient: sampled color at center, slightly transparent at edges to blend
    const cx=r.x+r.w/2, cy=r.y+r.h/2, rad=Math.max(r.w,r.h)*0.72;
    const grad=ctx.createRadialGradient(cx,cy,0,cx,cy,rad);
    grad.addColorStop(0,`rgb(${ri},${gi},${bi})`);
    grad.addColorStop(0.7,`rgb(${ri},${gi},${bi})`);
    grad.addColorStop(1,`rgba(${ri},${gi},${bi},0.6)`);
    ctx.fillStyle=grad;
  } else {
    ctx.fillStyle=`rgb(${ri},${gi},${bi})`;
  }
  ctx.fillRect(r.x,r.y,r.w,r.h);
}

async function wt_inpaintA1111(r) {
  const url=I('a1111url').value, prompt=I('a1111p').value, denoising=parseFloat(I('a1111d').value);
  const mask=document.createElement('canvas'); mask.width=S.wt.cv.width; mask.height=S.wt.cv.height;
  const mctx=mask.getContext('2d'); mctx.fillStyle='black'; mctx.fillRect(0,0,mask.width,mask.height);
  mctx.fillStyle='white'; mctx.fillRect(r.x,r.y,r.w,r.h);
  const imgB64=S.wt.cv.toDataURL('image/png').split(',')[1];
  const maskB64=mask.toDataURL('image/png').split(',')[1];
  try {
    wt_lg('i','Sending to A1111 inpainting API…');
    const resp=await fetch(url+'/sdapi/v1/img2img',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({init_images:[imgB64],mask:maskB64,prompt,negative_prompt:'text,letters,characters,watermark',
        inpainting_fill:1,inpaint_full_res:true,inpaint_full_res_padding:12,
        steps:25,denoising_strength:denoising,width:S.wt.cv.width,height:S.wt.cv.height,
        mask_blur:4})
    });
    const d=await resp.json();
    if(d.images?.[0]) {
      const img=new Image(); img.onload=()=>{
        S.wt.ctx.drawImage(img,0,0);
        S.wt.orig=S.wt.ctx.getImageData(0,0,S.wt.cv.width,S.wt.cv.height);
        wt_lg('o','A1111 inpainting done - background restored');
        wt_redraw();
      };
      img.src='data:image/png;base64,'+d.images[0];
    } else { throw new Error('No image in response: '+JSON.stringify(d).slice(0,200)); }
  } catch(e) { wt_lg('e','A1111 error: '+e.message); wt_lg('w','Make sure A1111 is running with --api flag and CORS is allowed'); }
}

// ─── TEXT RENDERING ───
function wt_drawText(r) {
  const ctx=S.wt.ctx;
  const font=I('wt_font').value, color=I('wt_tc').value, bold=I('wt_bold').checked;
  let fs=parseInt(I('wt_fs').value);
  const pad=parseInt(I('wt_pd').value);
  const maxW=r.w-pad*2, maxH=r.h-pad*2;
  ctx.textBaseline='top';
  // Auto-shrink font to fit region
  for(let attempt=0;attempt<10;attempt++){
    ctx.font=`${bold?'bold ':''} ${fs}px ${font}`;
    const lines=wt_wrap(ctx,r.trans,maxW);
    if(lines.length*fs*1.28<=maxH||fs<=6) break;
    fs=Math.max(6,Math.floor(fs*0.87));
  }
  ctx.font=`${bold?'bold ':''} ${fs}px ${font}`;
  const lines=wt_wrap(ctx,r.trans,maxW);
  const totalH=lines.length*fs*1.28;
  let sy=r.y+pad+Math.max(0,(maxH-totalH)/2);
  ctx.fillStyle=color;
  lines.forEach((line,i)=>ctx.fillText(line,r.x+pad,sy+i*fs*1.28));
}

function wt_wrap(ctx,text,maxW) {
  if(!text) return [];
  const words=text.split(' '); const lines=[]; let line='';
  for(const w of words){const t=line+(line?' ':'')+w;if(ctx.measureText(t).width>maxW&&line){lines.push(line);line=w;}else line=t;}
  if(line) lines.push(line); return lines;
}

function wt_redraw() {
  const wt=S.wt; if(!wt.ctx||!wt.orig) return;
  wt.ctx.putImageData(wt.orig,0,0);
  wt.regions.forEach(r=>{
    if(r.applied&&r.trans){wt_inpaint(r);wt_drawText(r);}
    const sel=r.id===wt.sel;
    wt.ctx.strokeStyle=sel?'#c8a96e':r.applied?'#6db88a':r.ocr?'#6b9fc4':'#9b7ec4';
    wt.ctx.lineWidth=(sel?2.5:1.5)/wt.scale;
    wt.ctx.setLineDash(r.applied?[]:[5/wt.scale,3/wt.scale]);
    wt.ctx.strokeRect(r.x,r.y,r.w,r.h); wt.ctx.setLineDash([]);
    wt.ctx.fillStyle=sel?'#c8a96e':'#9b7ec4';
    wt.ctx.font=`bold ${Math.max(9,11/wt.scale)}px sans-serif`;
    wt.ctx.fillText(wt.regions.indexOf(r)+1,r.x+3/wt.scale,r.y+13/wt.scale);
  });
}

