function acceptDiff() {
  // Keep the new translation (ch.out already has it)
  if (_diffChIdx >= 0) {
    S.epub.chapters[_diffChIdx].prevOut = null;
    renderEpQ(); renderEpList();
  }
  I('diffPanel').style.display = 'none';
}

function rejectDiff() {
  if (_diffChIdx >= 0) {
    const ch = S.epub.chapters[_diffChIdx];
    ch.out = ch.prevOut;
    ch.prevOut = null;
    renderEpQ(); renderEpList();
  }
  I('diffPanel').style.display = 'none';
}

