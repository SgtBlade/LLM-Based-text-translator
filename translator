<script>
// ═══════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════
const I = id => document.getElementById(id);
const rv = (id,vid) => { const e=I(id),v=I(vid); if(e&&v) v.textContent=e.value; };
const rvF = (id,vid) => { const e=I(id),v=I(vid); if(e&&v) v.textContent=parseFloat(e.value).toFixed(2); };
const sleep = ms => new Promise(r=>setTimeout(r,ms));
const pickFile = (accept,cb) => { const i=document.createElement('input'); i.type='file'; i.accept=accept; i.onchange=e=>{if(e.target.files[0])cb(e.target.files[0]);}; i.click(); };
const dlBlob = (content,name,type='text/plain') => { const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([content],{type})); a.download=name; a.click(); };
const dlJSON = (d,n) => dlBlob(JSON.stringify(d,null,2),n,'application/json');


// ═══════════════════════════════════════════
// PROVIDER ABSTRACTION
// ═══════════════════════════════════════════

// Current provider: 'ollama' | 'claude' | 'openai' | 'gemini'
let _provider = 'ollama';

function setProvider(p) {
  _provider = p;
  // Update provider card highlight
  ['ollama','claude','openai','gemini'].forEach(x => {
    const card = I('prov-' + x);
    if (card) card.className = 'prov-card' + (x === p ? ' on' : '');
    const sec = I('ps-' + x);
    if (sec) sec.className = 'prov-section' + (x === p ? ' on' : '');
  });
  // Update model list label
  const hint = I('prov-model-hint');
  if (hint) hint.textContent = '- ' + { ollama:'Ollama', claude:'Claude', openai:'OpenAI', gemini:'Gemini' }[p];
  // Refresh model list / status display
  if (p === 'ollama') {
    checkOllama();
  } else {
    const mlistEl = I('mlist');
    if (mlistEl) mlistEl.innerHTML = '<span style="color:var(--tx3)">Cloud API - models set above · no local list needed</span>';
    I('sdot').className = 'dot'; I('stxt').textContent = 'Cloud API';
  }
  // Save provider to config
  if (I('provider')) I('provider').value = p;
  saveC();
  updDUI();
}

// Restore provider from saved config
function loadProvider() {
  const saved = localStorage.getItem('ts4c');
  if (!saved) return;
  try {
    const c = JSON.parse(saved);
    if (c.provider) setProvider(c.provider);
  } catch(e) {}
}

// Show/hide API key
function toggleKeyVisibility(inputId) {
  const el = I(inputId);
  if (el) el.type = el.type === 'password' ? 'text' : 'password';
}

// Get the currently active model name for a role
// For cloud providers, all roles use the single selected model
function getModelForRole(role) {
  if (_provider === 'ollama') {
    if (role === 'A') return I('mdlA')?.value || '';
    if (role === 'B') return I('mdlB')?.value || '';
    if (role === 'G') return I('mdlG')?.value || '';
    return I('mdlA')?.value || '';
  }
  if (_provider === 'claude')  return I('claudeModel')?.value  || 'claude-sonnet-4-5';
  if (_provider === 'openai')  return I('openaiModel')?.value  || 'gpt-4.1-mini';
  if (_provider === 'gemini')  return I('geminiModel')?.value  || 'gemini-2.5-flash';
  return '';
}

// ── Provider-specific chat implementations ──

async function chatClaude(model, sys, user, temp, signal) {
  const key = I('claudeKey')?.value?.trim();
  if (!key) throw new Error('Claude API key not set - add it in Models → Provider');
  const useCache = I('claudeCache')?.checked;

  // Build content array - with optional cache breakpoints on system prompt
  const sysContent = useCache
    ? [{ type: 'text', text: sys, cache_control: { type: 'ephemeral' } }]
    : sys;

  const body = {
    model,
    max_tokens: 4096,
    temperature: temp,
    messages: [{ role: 'user', content: user }]
  };
  if (sys) body.system = sysContent;

  const headers = {
    'Content-Type': 'application/json',
    'x-api-key': key,
    'anthropic-version': '2023-06-01'
  };
  if (useCache) headers['anthropic-beta'] = 'prompt-caching-2024-07-31';

  const r = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST', headers, body: JSON.stringify(body), signal
  });
  if (!r.ok) {
    const err = await r.json().catch(() => ({}));
    throw new Error('Claude API error ' + r.status + ': ' + (err.error?.message || r.statusText));
  }
  const d = await r.json();
  return (d.content?.[0]?.text || '').trim();
}

async function chatOpenAI(model, sys, user, temp, signal) {
  const key = I('openaiKey')?.value?.trim();
  if (!key) throw new Error('OpenAI API key not set - add it in Models → Provider');

  const messages = [];
  if (sys) messages.push({ role: 'system', content: sys });
  messages.push({ role: 'user', content: user });

  const r = await fetch('https://api.openai.com/v1/chat/completions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
    body: JSON.stringify({ model, messages, temperature: temp, max_tokens: 4096 }),
    signal
  });
  if (!r.ok) {
    const err = await r.json().catch(() => ({}));
    throw new Error('OpenAI API error ' + r.status + ': ' + (err.error?.message || r.statusText));
  }
  const d = await r.json();
  return (d.choices?.[0]?.message?.content || '').trim();
}

async function chatGemini(model, sys, user, temp, signal) {
  const key = I('geminiKey')?.value?.trim();
  if (!key) throw new Error('Gemini API key not set - add it in Models → Provider');

  // Gemini uses system_instruction separately
  const body = {
    contents: [{ role: 'user', parts: [{ text: user }] }],
    generationConfig: { temperature: temp, maxOutputTokens: 4096 }
  };
  if (sys) body.system_instruction = { parts: [{ text: sys }] };

  const url = `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`;
  const r = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
    signal
  });
  if (!r.ok) {
    const err = await r.json().catch(() => ({}));
    throw new Error('Gemini API error ' + r.status + ': ' + (err.error?.message || r.statusText));
  }
  const d = await r.json();
  return (d.candidates?.[0]?.content?.parts?.[0]?.text || '').trim();
}

// ── Claude Batch API for EPUB ──
// Submits all chunks as a batch, polls for completion, returns results in order

async function runClaudeBatch(chunks, sysPrompt, temp) {
  const key = I('claudeKey')?.value?.trim();
  if (!key) throw new Error('Claude API key not set');
  const model = I('claudeModel')?.value || 'claude-sonnet-4-5';
  const useCache = I('claudeCache')?.checked;

  lg('i', `Claude batch: submitting ${chunks.length} chunks…`);

  const requests = chunks.map((chunk, i) => ({
    custom_id: 'chunk-' + i,
    params: {
      model,
      max_tokens: 4096,
      temperature: temp,
      system: useCache
        ? [{ type: 'text', text: sysPrompt, cache_control: { type: 'ephemeral' } }]
        : sysPrompt,
      messages: [{ role: 'user', content: chunk }]
    }
  }));

  const headers = {
    'Content-Type': 'application/json',
    'x-api-key': key,
    'anthropic-version': '2023-06-01'
  };
  if (useCache) headers['anthropic-beta'] = 'prompt-caching-2024-07-31';

  // Submit batch
  const submitR = await fetch('https://api.anthropic.com/v1/messages/batches', {
    method: 'POST', headers,
    body: JSON.stringify({ requests })
  });
  if (!submitR.ok) {
    const err = await submitR.json().catch(() => ({}));
    throw new Error('Batch submit failed: ' + (err.error?.message || submitR.statusText));
  }
  const batch = await submitR.json();
  const batchId = batch.id;
  lg('i', `Claude batch submitted: ${batchId} - polling for results…`);

  // Poll until processing_status === 'ended'
  let attempts = 0;
  const maxAttempts = 180; // 15 min at 5s intervals
  while (attempts < maxAttempts) {
    await sleep(5000);
    attempts++;
    const pollR = await fetch(`https://api.anthropic.com/v1/messages/batches/${batchId}`, { headers });
    if (!pollR.ok) continue;
    const status = await pollR.json();
    const done = status.request_counts?.succeeded + status.request_counts?.errored + status.request_counts?.canceled;
    const total = status.request_counts?.processing + done;
    lg('i', `Batch poll ${attempts}: ${done}/${total} complete`);
    if (status.processing_status === 'ended') break;
  }
  if (attempts >= maxAttempts) throw new Error('Claude batch timed out after 15 minutes');

  // Fetch results
  const resultsR = await fetch(`https://api.anthropic.com/v1/messages/batches/${batchId}/results`, { headers });
  if (!resultsR.ok) throw new Error('Could not fetch batch results');
  const resultsText = await resultsR.text();

  // Results are JSONL - one JSON object per line
  const results = new Map();
  for (const line of resultsText.trim().split('\n')) {
    if (!line.trim()) continue;
    try {
      const obj = JSON.parse(line);
      if (obj.result?.type === 'succeeded') {
        results.set(obj.custom_id, obj.result.message.content?.[0]?.text || '');
      } else {
        results.set(obj.custom_id, '');
        lg('w', `Batch chunk ${obj.custom_id} failed: ${obj.result?.error?.message || 'unknown'}`);
      }
    } catch(e) {}
  }

  // Return in original chunk order
  return chunks.map((_, i) => results.get('chunk-' + i) || '');
}

// ═══════════════════════════════════════════
// OLLAMA CHAT
// ═══════════════════════════════════════════
async function chat(model, sys, user, temp, signal) {
  // Dispatch to the active provider
  if (_provider === 'claude')  return chatClaude(model, sys, user, temp, signal);
  if (_provider === 'openai')  return chatOpenAI(model, sys, user, temp, signal);
  if (_provider === 'gemini')  return chatGemini(model, sys, user, temp, signal);
  // Default: Ollama
  const messages = [];
  if (sys) messages.push({ role: 'system', content: sys });
  messages.push({ role: 'user', content: user });
  // NOTE: num_ctx (total context window) and num_predict (output length cap) are
  // two different Ollama parameters. Previously this only set num_ctx from the
  // "max tokens" slider, so nothing ever actually capped/reserved output length -
  // the system prompt + dictionary + input chunk could eat the entire budget,
  // leaving too little room to generate a full translation (truncated/untranslated
  // tails, and duplicate text if a retry re-generated from an earlier point).
  const numPredict = parseInt(I('mt').value) || 4096;
  const promptChars = (sys ? sys.length : 0) + user.length;
  // Rough KR/EN mixed-text estimate: ~2.2 chars/token, plus 20% headroom for variance.
  const estPromptTokens = Math.ceil((promptChars * 1.2) / 2.2);
  const numCtx = Math.max(4096, estPromptTokens + numPredict + 512);
  const r = await fetch(I('obase').value + '/api/chat', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model, stream: false,
      keep_alive: '30m', // keep the model resident between chunks - avoids reload stalls on local GPU runs
      options: { temperature: temp, num_ctx: numCtx, num_predict: numPredict },
      messages
    }),
    signal
  });
  if (!r.ok) throw new Error('HTTP ' + r.status + ' from Ollama');
  const d = await r.json();
  return (d.message?.content || d.response || '').trim();
}

// ═══════════════════════════════════════════
// CHUNKING// ═══════════════════════════════════════════
// CHUNKING
// ═══════════════════════════════════════════
// modelKey: 'A' | 'B' | 'G' | null (null = use global 'cs' slider)
function chunkText(text, modelKey) {
  let sz;
  if (modelKey === 'A' && I('csA')) sz = parseInt(I('csA').value) || 3000;
  else if (modelKey === 'B' && I('csB')) sz = parseInt(I('csB').value) || 3000;
  else if (modelKey === 'G' && I('csG')) sz = parseInt(I('csG').value) || 3000;
  else sz = parseInt(I('cs')?.value) || 3000;
  const smart = I('smart') ? I('smart').checked : true;
  if (!smart) {
    const r = [];
    for (let i = 0; i < text.length; i += sz) r.push(text.slice(i, i + sz));
    return r;
  }
  const chunks = []; let rem = text;
  while (rem.length > sz) {
    const lim = Math.floor(sz * 0.65);
    const at = findBreakPoint(rem, sz, lim);
    chunks.push(rem.slice(0, at));
    rem = rem.slice(at);
  }
  if (rem.trim()) chunks.push(rem);
  return chunks;
}

// Finds the best place to cut `rem` at or before position `sz`, preferring
// (in priority order): paragraph break > line break > sentence end > whitespace > hard cut.
// `lim` is the earliest acceptable cut position - a break found before `lim` is
// too far back and would make the chunk too small, so we fall through to the
// next-best tier instead. Ending a chunk mid-sentence forces the model to
// translate half a thought with no idea how it concludes, which is a common
// source of garbled or incomplete output - sentence-end is a load-bearing
// fallback here, not a nice-to-have.
function findBreakPoint(rem, sz, lim) {
  const paraIdx = rem.lastIndexOf('\n\n', sz);
  if (paraIdx >= lim) return paraIdx + 2;

  const lineIdx = rem.lastIndexOf('\n', sz);
  if (lineIdx >= lim) return lineIdx + 1;

  // Sentence-ending punctuation (Korean or English), optionally followed by
  // a closing quote mark, followed by whitespace or end of window.
  const window = rem.slice(0, sz);
  const sentenceRe = /[.!?\u2026][""'\u2019]?(?=\s|$)/g;
  let lastMatch = null, m;
  while ((m = sentenceRe.exec(window)) !== null) {
    if (m.index >= lim) lastMatch = m;
  }
  if (lastMatch) return lastMatch.index + lastMatch[0].length;

  // No sentence boundary found - at least avoid splitting a word/character token.
  const spaceIdx = rem.lastIndexOf(' ', sz);
  if (spaceIdx >= lim) return spaceIdx + 1;

  // Last resort: hard cut. Only hits on extremely long unbroken runs of text.
  return sz;
}

// ═══════════════════════════════════════════
// PROMPT BUILDERS
// ═══════════════════════════════════════════
// Build translation system prompt, injecting ONLY dictionary entries
// whose Korean key actually appears in the current chunk.
// Falls back to full dict if no chunkText is provided (e.g. in queue runners).
function buildTP(chunkText) {
  let base = I('pTrans').value;
  base = applyLangVars(base);
  if (!S.dict.length) return base;

  const relevant = chunkText
    ? S.dict.filter(d => chunkText.includes(d.k))
    : S.dict;

  if (!relevant.length) return base;

  const lines = relevant.map(d => '  ' + d.k + ' → ' + d.e + (d.n ? ' (' + d.n + ')' : '')).join('\n');
  return base + '\n\nDictionary (' + relevant.length + ' of ' + S.dict.length + ' entries matched this passage):\n' + lines;
}

function applyLangVars(text) {
  const from = I('fromLang')?.value || 'Korean';
  const to   = I('toLang')?.value   || 'English';
  return text.replace(/\{fromLanguage\}/g, from).replace(/\{toLanguage\}/g, to);
}

function updLangPreview() {
  const el = I('langPreview'); if(!el) return;
  const from = I('fromLang')?.value || 'Korean';
  const to   = I('toLang')?.value   || 'English';
  const prompt = I('pTrans')?.value || '';
  if(prompt.includes('{fromLanguage}') || prompt.includes('{toLanguage}')) {
    el.textContent = `→ translates ${from} to ${to}`;
    el.style.color = 'var(--ac)';
  } else {
    el.textContent = `ℹ add {fromLanguage}/{toLanguage} to use language fields`;
    el.style.color = 'var(--tx3)';
  }
}
function buildAuditP(chunkText) {
  let base = applyLangVars(I('pAudit').value);
  if (!S.dict.length) return base;

  const relevant = chunkText
    ? S.dict.filter(d => chunkText.includes(d.k))
    : S.dict;

  if (!relevant.length) return base;
  return base + '\n\nPreserve these names and terms exactly: '
    + relevant.map(d => d.e).join(', ');
}

// Post-process: for each dictionary entry whose Korean key appears in the
// source chunk, check whether the model used the correct English term.
// If it used a variant spelling, replace it deterministically.
// Only applied to clearly name-like entries (no spaces, first char uppercase).
function applyPostProcessing(output, chunkText) {
  if (!output || !chunkText || !S.dict.length) return output;
  let result = output;
  for (const d of S.dict) {
    if (!chunkText.includes(d.k)) continue;  // term not in source chunk
    if (!d.e || d.e.includes('─')) continue; // skip section separators
    // Only post-process proper names: no spaces in target, or 1-2 word capitalised names
    const words = d.e.trim().split(/\s+/);
    if (words.length > 4) continue; // skip long phrases - too risky to replace
    if (!/^[A-Z]/.test(d.e)) continue; // must start uppercase to be a name
    // Check if the exact correct form is already present - if so skip
    if (result.includes(d.e)) continue;
    // Build a loose regex to catch common model variants:
    // e.g. "Shin Haru" might come out "Shin Haru" (fine), "ShinHaru", "shin haru", "Shin-Haru"
    // Only replace if we find a close variant to avoid clobbering unrelated text
    for (const variant of buildNameVariants(d.e)) {
      const rx = new RegExp(variant, 'g');
      if (rx.test(result)) {
        result = result.replace(rx, d.e);
        break;
      }
    }
  }
  return result;
}

function buildNameVariants(name) {
  // Generate plausible mistranslation variants of a name
  const variants = [];
  // lowercase version
  variants.push(name.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  // hyphenated version: "Shin Haru" → "Shin-Haru"
  variants.push(name.replace(/\s+/g, '-').replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  // no-space version: "Shin Haru" → "ShinHaru"
  const noSpace = name.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join('');
  variants.push(noSpace.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  return variants.filter(v => v !== name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
}
function buildGP() {
  return I('pGram').value
    + (S.dict.length ? '\n\nPreserve these names exactly: ' + S.dict.map(d => d.e).join(', ') : '');
}

