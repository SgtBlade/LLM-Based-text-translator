// ── Timing state for ETA tracking ──
const _timing = {
  stepStart: null,       // when current step started
  chunkTimes: [],        // ms per chunk for rolling average
  lastChunkStart: null,  // when current chunk started
  lastActivity: null,    // timestamp of last Ollama response
  stuckTimer: null,      // timer to detect if stuck
  totalChunks: 0,
  currentChunk: 0,
  phase: 'idle',
};

function _fmtSecs(ms) {
  if (ms < 0 || !isFinite(ms)) return '-';
  const s = Math.round(ms / 1000);
  if (s < 60) return s + 's';
  const m = Math.floor(s / 60), r = s % 60;
  return m + 'm ' + r + 's';
}

function _heartbeat() {
  const dot = I('hbDot');
  if (!dot) return;
  dot.className = 'hb pulse';
  setTimeout(() => { dot.className = 'hb'; }, 700);
  _timing.lastActivity = Date.now();
  // Reset stuck detector - if no heartbeat for 90s, warn
  clearTimeout(_timing.stuckTimer);
  _timing.stuckTimer = setTimeout(() => {
    const v = I('sb-msg-v');
    const lastCell = I('sb-last');
    if (v && _timing.phase !== 'idle' && _timing.phase !== 'done') {
      v.textContent = '⚠ No response for 90s - model may be stuck or OOM';
      v.style.color = 'var(--rd)';
    }
  }, 90000);
}

function statusChunkStart(chunkNum, totalChunks) {
  _timing.currentChunk = chunkNum;
  _timing.totalChunks  = totalChunks;
  _timing.lastChunkStart = Date.now();
  _heartbeat();
  _updateStatusBar();
}

function statusChunkDone() {
  const elapsed = Date.now() - (_timing.lastChunkStart || Date.now());
  _timing.chunkTimes.push(elapsed);
  if (_timing.chunkTimes.length > 8) _timing.chunkTimes.shift(); // rolling window
  _heartbeat();
  _updateStatusBar();
}

function _updateStatusBar() {
  const phaseEl  = I('sb-phase-v');
  const chunkEl  = I('sb-chunk-v');
  const elapsEl  = I('sb-elapsed-v');
  const etaEl    = I('sb-eta-v');
  const lastEl   = I('sb-last-v');
  const msgEl    = I('sb-msg-v');
  if (!phaseEl) return;

  const phaseNames = {
    idle:'Idle', transA:'Translating (Pass A)', transB:'Translating (Pass B)',
    auditing:'Auditing', done:'Done ✓', error:'Error'
  };
  phaseEl.textContent = phaseNames[_timing.phase] || _timing.phase;

  // Chunk counter
  if (_timing.totalChunks > 0) {
    chunkEl.textContent = _timing.currentChunk + ' / ' + _timing.totalChunks;
  } else {
    chunkEl.textContent = '-';
  }

  // Step elapsed
  if (_timing.stepStart) {
    elapsEl.textContent = _fmtSecs(Date.now() - _timing.stepStart);
  }

  // ETA - based on rolling average of last 8 chunk times
  if (_timing.chunkTimes.length > 0 && _timing.totalChunks > 0) {
    const avg = _timing.chunkTimes.reduce((a,b)=>a+b,0) / _timing.chunkTimes.length;
    const remaining = _timing.totalChunks - _timing.currentChunk;
    etaEl.textContent = remaining > 0 ? '~' + _fmtSecs(avg * remaining) : 'Almost done';
  } else {
    etaEl.textContent = 'Calculating…';
  }

  // Last response age
  if (_timing.lastActivity) {
    const age = Math.round((Date.now() - _timing.lastActivity) / 1000);
    lastEl.textContent = age + 's ago';
    lastEl.style.color = age > 60 ? 'var(--rd)' : age > 30 ? 'var(--ac)' : 'var(--tx)';
  }
}

// Update elapsed time every second while running
let _elapsedInterval = null;
function _startElapsedTick() {
  clearInterval(_elapsedInterval);
  _elapsedInterval = setInterval(() => {
    if (_timing.phase === 'idle' || _timing.phase === 'done') {
      clearInterval(_elapsedInterval); return;
    }
    _updateStatusBar();
  }, 1000);
}

function setPipeStatus(phase, msg) {
  _timing.phase = phase;
  // Reset chunk tracking on new phase
  if (phase === 'transA' || phase === 'idle') {
    _timing.chunkTimes = [];
    _timing.currentChunk = 0;
    _timing.totalChunks  = 0;
  }
  if (phase !== 'idle' && phase !== 'done' && phase !== 'error') {
    if (!_timing.stepStart || phase !== _timing.lastPhase) {
      _timing.stepStart = Date.now();
      _startElapsedTick();
    }
  }
  _timing.lastPhase = phase;

  // Update pipe strip
  ['ps-trans','ps-audit','ps-status'].forEach(id=>{
    const el=I(id); if(el) el.className='pipe-step';
  });
  const sl=I('ps-status-lbl');
  if (phase==='idle')       { if(sl) sl.textContent='Idle'; clearTimeout(_timing.stuckTimer); }
  else if(phase==='transA') { I('ps-trans').className='pipe-step active'; if(sl) sl.textContent=msg||'Pass A'; }
  else if(phase==='transB') { I('ps-trans').className='pipe-step active'; if(sl) sl.textContent=msg||'Pass B'; }
  else if(phase==='auditing'){ I('ps-trans').className='pipe-step done'; I('ps-audit').className='pipe-step active'; if(sl) sl.textContent=msg||'Auditing'; }
  else if(phase==='done')   { I('ps-trans').className='pipe-step done'; if(I('ps-audit')) I('ps-audit').className='pipe-step done'; if(sl) sl.textContent='Done ✓'; clearTimeout(_timing.stuckTimer); }
  else if(phase==='error')  { if(sl) sl.textContent='Error'; clearTimeout(_timing.stuckTimer); }

  // Update status bar phase cell color
  const phaseCell = I('sb-phase');
  if (phaseCell) {
    phaseCell.className = 'sb-cell' + (phase==='done'?' ok':phase==='error'?' err':phase==='idle'?'':' active');
  }
  const msgEl = I('sb-msg-v');
  if (msgEl) { msgEl.textContent = msg || phaseNames[phase] || phase; msgEl.style.color = ''; }

  _updateStatusBar();
}

const phaseNames = {
  idle:'Waiting for input', transA:'Translating with Model A…',
  transB:'Translating with Model B…', auditing:'Auditing / arbitrating…',
  done:'Complete', error:'Error - check log'
};

// ═══════════════════════════════════════════
// SEQUENTIAL DUAL WORKFLOW  (new recommended)
// Full pass A → Full pass B → G arbitrates sentence-by-sentence
// One model in VRAM at a time
// ═══════════════════════════════════════════
// ═══════════════════════════════════════════
// PARAGRAPH-AWARE ARBITRATION HELPERS
// ═══════════════════════════════════════════

// Join arbitrated sentences back into paragraphs, restoring paragraph breaks
function joinArbitratedSents(sents) {
  if (!sents.length) return '';
  let result = '', para = '';
  for (let i = 0; i < sents.length; i++) {
    const s = sents[i];
    para += (para ? ' ' : '') + s.chosen;
    if (s.paraBreak) {
      result += (result ? '\n\n' : '') + para;
      para = '';
    }
  }
  if (para) result += (result ? '\n\n' : '') + para;
  return result;
}

// Paragraph-aware arbitration: split both texts into paragraphs,
// arbitrate sentence-by-sentence within each paragraph, preserve structure
async function arbitrateWithStructure(rawA, rawB, model, temp, signal) {
  const parasA = rawA.split(/\n{2,}/);
  const parasB = rawB.split(/\n{2,}/);
  const maxP   = Math.max(parasA.length, parasB.length);
  const allSents = [];

  for (let p = 0; p < maxP; p++) {
    if (signal?.aborted) break;
    const pA = parasA[p] || '';
    const pB = parasB[p] || '';
    const paraSents = await arbitrateSentences(pA, pB, model, temp, signal);
    // Mark the last sentence of each paragraph (except the final one) with paraBreak
    if (paraSents.length) {
      paraSents[paraSents.length - 1].paraBreak = (p < maxP - 1);
    }
    allSents.push(...paraSents);
  }
  return allSents;
}

// ═══════════════════════════════════════════
// SENTENCE-LEVEL ARBITRATION HELPER
// ═══════════════════════════════════════════
function splitSentences(text) {
  return text.match(/[^.!?…\n]+[.!?…]+\s*/g)?.map(s=>s.trim()).filter(s=>s.length>3)||[text];
}

async function arbitrateSentences(rawA, rawB, model, temp, signal) {
  const sentA=splitSentences(rawA), sentB=splitSentences(rawB);
  const maxLen=Math.max(sentA.length, sentB.length);
  const results=[];
  // Strict system prompt - no explanations, no labels, just the sentence
  const sys='You are a translation selector. Given two English translations of the same sentence, output ONLY the better one as plain text.\nRules: No labels. No explanation. No preamble. No "Translation A/B:". Just the sentence itself.\nPick whichever is more natural, accurate, and fitting for a Korean web novel.';

  for(let i=0;i<maxLen;i++) {
    if(signal?.aborted) break;
    const a=sentA[i]||sentA[sentA.length-1]||'';
    const b=sentB[i]||sentB[sentB.length-1]||'';
    if(!a&&!b) continue;
    if(!a){results.push({sentA:'',sentB:b,chosen:b,auto:true});continue;}
    if(!b){results.push({sentA:a,sentB:'',chosen:a,auto:true});continue;}
    if(a===b){results.push({sentA:a,sentB:b,chosen:a,auto:true});continue;}
    try {
      const chosen=await chat(model, sys, `Sentence A: ${a}\nSentence B: ${b}`, temp, signal);
      const clean=chosen.trim();
      // Guard: if the model returned something suspiciously long or explanation-like, fall back to A
      const looksLikeExplanation=clean.length>a.length*3
        || /\b(because|since|translation [ab]|sentence [ab]|i chose|i pick|this one is|better|clearer|more natural)\b/i.test(clean.slice(0,100));
      results.push({sentA:a, sentB:b, chosen:looksLikeExplanation?a:clean, auto:true});
    } catch(e) {
      results.push({sentA:a, sentB:b, chosen:a, auto:true});
    }
  }
  return results;
}

async function runSeqDual(sourceText, signal, onPassA, onPassB, onFinal) {
  const mA=I('mdlA').value, mB=I('mdlB').value, mG=I('mdlG').value;
  const tA=parseFloat(I('ta').value), tB=parseFloat(I('tb').value), tG=parseFloat(I('tg').value);
  const delay=parseInt(I('cd').value);
  const chunks=chunkText(sourceText,'A');

  // ── PASS A: full translation with Model A ──
  let ctxTailA='', ctxTailB='';
  setPipeStatus('transA', `Pass A - ${mA} · ${chunks.length} chunk(s)`);
  lg('i', `Sequential dual - Pass A: ${mA}`);
  let rawA='';
  for(let i=0;i<chunks.length;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, chunks.length);
    I('cf').style.width=Math.round((i/(chunks.length*3))*100)+'%';
    I('cinfo').textContent=`Pass A: chunk ${i+1}/${chunks.length}`;
    const _clean=cleanChunkForModel(chunks[i]);
    const _ctx=getContextTail(contextTail||'');
    const out=await chatWithRetry(mA, buildTP(_clean), withContext(_clean,_ctx), tA, signal, _clean);
    statusChunkDone();
    rawA+=(i>0?'\n\n':'')+out;
    if(onPassA) onPassA(out, i===0);
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }
  lg('o', `Pass A complete · ${rawA.length} chars`);

  // ── PASS B: full translation with Model B ──
  setPipeStatus('transB', `Pass B - ${mB} · ${chunks.length} chunk(s)`);
  lg('i', `Sequential dual - Pass B: ${mB}`);
  let rawB='';
  for(let i=0;i<chunks.length;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, chunks.length);
    I('cf').style.width=Math.round(((chunks.length+i)/(chunks.length*3))*100)+'%';
    I('cinfo').textContent=`Pass B: chunk ${i+1}/${chunks.length}`;
    const _cleanB=cleanChunkForModel(chunks[i]);
    const out=await chatWithRetry(mB, buildTP(_cleanB), _cleanB, tB, signal, _cleanB);
    statusChunkDone();
    rawB+=(i>0?'\n\n':'')+out;
    if(onPassB) onPassB(out, i===0);
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }
  lg('o', `Pass B complete · ${rawB.length} chars`);

  // ── PASS G: sentence-level arbitration comparing both full translations ──
  if(I('skipAudit')?.checked) { lg('w','Audit skipped - using Model A output'); return rawA; }
  setPipeStatus('auditing', `Arbitrating - ${mG||'heuristic'}`);
  lg('i', `Sequential dual - Arbitration: ${mG||'(no G model, using heuristic)'}`);

  // Re-align into chunks for arbitration context
  const chunksA=chunkText(rawA,'A');
  const chunksB=chunkText(rawB,'B');
  S.arbData=[];
  let finalText='';
  const totalChunks=Math.max(chunksA.length, chunksB.length);

  for(let i=0;i<totalChunks;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, totalChunks);
    I('cf').style.width=Math.round(((chunks.length*2+i)/(chunks.length*3))*100)+'%';
    I('cinfo').textContent=`Arbitrate: chunk ${i+1}/${totalChunks}`;
    const cA=chunksA[i]||'', cB=chunksB[i]||'';
    if(mG) {
      const sents=await arbitrateWithStructure(cA, cB, mG, tG, signal);
      S.arbData.push(...sents);
      const chunkFinal=joinArbitratedSents(sents);
      finalText+=(i>0?'\n\n':'')+chunkFinal;
      if(onFinal) onFinal(chunkFinal, i===0);
      statusChunkDone();
    } else {
      // No G model - use length heuristic per sentence, preserve paragraphs
      const parasA=cA.split(/\n{2,}/), parasB=cB.split(/\n{2,}/);
      const maxP=Math.max(parasA.length,parasB.length);
      const paraResults=[];
      for(let p=0;p<maxP;p++) {
        const pA=parasA[p]||'', pB=parasB[p]||'';
        const sentsA=splitSentences(pA), sentsB=splitSentences(pB);
        const maxS=Math.max(sentsA.length,sentsB.length);
        const paraSents=[];
        for(let j=0;j<maxS;j++) {
          const sA=sentsA[j]||sentsA[sentsA.length-1]||'';
          const sB=sentsB[j]||sentsB[sentsB.length-1]||'';
          paraSents.push({sentA:sA,sentB:sB,chosen:sA.length>=sB.length?sA:sB,auto:true,paraBreak:false});
        }
        if(paraSents.length) paraSents[paraSents.length-1].paraBreak=(p<maxP-1);
        S.arbData.push(...paraSents);
        paraResults.push(paraSents);
      }
      const chunkFinal=paraResults.map(ps=>ps.map(s=>s.chosen).join(' ')).join('\n\n');
      finalText+=(i>0?'\n\n':'')+chunkFinal;
      if(onFinal) onFinal(chunkFinal, i===0);
    }
    if(delay>0 && i<totalChunks-1) await sleep(delay);
  }
  lg('o', `Arbitration complete · ${S.arbData.length} sentences processed`);
  return finalText;
}

// ═══════════════════════════════════════════
// SINGLE WORKFLOW (A translates → G audits with Korean source)
// ═══════════════════════════════════════════
async function runSequential(sourceText, signal, onTransChunk, onAuditChunk) {
  const mA=I('mdlA').value, mG=I('mdlG').value;
  const tA=parseFloat(I('ta').value), tG=parseFloat(I('tg').value);
  const delay=parseInt(I('cd').value);
  const chunks=chunkText(sourceText,'A');
  let contextTail='';

  // Pass 1: Translate
  setPipeStatus('transA', `Translating - ${mA} · ${chunks.length} chunk(s)`);
  lg('i', `Single - Translate: ${mA}`);
  let rawTranslation='';
  for(let i=0;i<chunks.length;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, chunks.length);
    I('cf').style.width=Math.round((i/(mG?chunks.length*2:chunks.length))*100)+'%';
    I('cinfo').textContent=`Translate ${i+1}/${chunks.length}`;
    const out=await translateChunkWithFallback(mA, chunks[i], tA, signal, `Chunk ${i+1}/${chunks.length}`);
    statusChunkDone();
    const out_pp=applyPostProcessing(out, chunks[i]);
    rawTranslation+=(i>0?'\n\n':'')+out_pp;
    contextTail=out_pp;
    if(onTransChunk) onTransChunk(out_pp, i===0);
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }

  if(!mG || I('skipAudit')?.checked) { lg('w', I('skipAudit')?.checked ? 'Audit skipped (toggle is on)' : 'No audit model - skipping audit'); return rawTranslation; }

  // Pass 2: Audit (Korean source + translation together)
  setPipeStatus('auditing', `Auditing - ${mG} · ${chunks.length} chunk(s)`);
  lg('i', `Single - Audit: ${mG} (Korean + translation)`);
  const transChunks=chunkText(rawTranslation,'G');
  let auditedText='';
  const total=Math.max(chunks.length, transChunks.length);
  for(let i=0;i<total;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, total);
    I('cf').style.width=Math.round(((chunks.length+i)/(chunks.length*2))*100)+'%';
    I('cinfo').textContent=`Audit ${i+1}/${total}`;
    const korChunk=chunks[i]||'';
    const userMsg=`Korean original:\n${korChunk}\n\n---\n\nEnglish translation to audit:\n${transChunks[i]||''}`;
    const out=await chatWithRetry(mG, buildAuditP(korChunk), userMsg, tG, signal, transChunks[i]||'');
    statusChunkDone();
    auditedText+=(i>0?'\n\n':'')+out;
    if(onAuditChunk) onAuditChunk(out, i===0);
    if(delay>0 && i<total-1) await sleep(delay);
  }
  // Fallback: if audit returned empty, use the raw translation
  if (!auditedText.trim()) {
    lg('w', 'Audit returned empty - using raw translation as fallback');
    return rawTranslation;
  }
  return auditedText;
}

// ═══════════════════════════════════════════
// PARALLEL DUAL WORKFLOW (A+B per chunk → G arbitrates)
// ═══════════════════════════════════════════
async function runDual(sourceText, signal, onA, onB) {
  const mA=I('mdlA').value, mB=I('mdlB').value, mG=I('mdlG').value;
  const tA=parseFloat(I('ta').value), tB=parseFloat(I('tb').value), tG=parseFloat(I('tg').value);
  const delay=parseInt(I('cd').value);
  const chunks=chunkText(sourceText,'A');
  S.arbData=[];

  for(let i=0;i<chunks.length;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, chunks.length);
    I('cf').style.width=Math.round((i/chunks.length)*100)+'%';
    I('cinfo').textContent=`Chunk ${i+1}/${chunks.length} (A+B parallel)`;
    lg('i', `Parallel chunk ${i+1}/${chunks.length} → ${mA} + ${mB}`);
    const [rA,rB]=await Promise.all([
      translateChunkWithFallback(mA, chunks[i], tA, signal, `Chunk ${i+1}/${chunks.length} (A)`),
      translateChunkWithFallback(mB, chunks[i], tB, signal, `Chunk ${i+1}/${chunks.length} (B)`)
    ]);
    statusChunkDone();
    if(onA) onA(rA, i===0); if(onB) onB(rB, i===0);
    if(mG && !I('skipAudit')?.checked) {
      const sents=await arbitrateWithStructure(rA, rB, mG, tG, signal);
      S.arbData.push(...sents);
    } else {
      const best=rA.length>=rB.length?rA:rB;
      S.arbData.push(...splitSentences(best).map(s=>({sentA:s,sentB:s,chosen:s,auto:true,paraBreak:false})));
    }
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }
  return S.arbData.map(s=>s.chosen).join(' ');
}

async function runSingle(sourceText, signal, onChunk) {
  const mA=I('mdlA').value;
  const tA=parseFloat(I('ta').value);
  const delay=parseInt(I('cd').value);
  const chunks=chunkText(sourceText,'A');
  let out='', contextTail='';
  for(let i=0;i<chunks.length;i++) {
    if(signal?.aborted) throw new DOMException('Aborted','AbortError');
    statusChunkStart(i+1, chunks.length);
    I('cf').style.width=Math.round((i/chunks.length)*100)+'%';
    I('cinfo').textContent=`Chunk ${i+1}/${chunks.length}`;
    const result=await translateChunkWithFallback(mA, chunks[i], tA, signal, `Chunk ${i+1}/${chunks.length}`);
    statusChunkDone();
    const result_pp=applyPostProcessing(result, chunks[i]);
    out+=(i>0?'\n\n':'')+result_pp;
    contextTail=result_pp;
    if(onChunk) onChunk(result_pp, i===0);
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }
  return out;
}

// ═══════════════════════════════════════════
// TRANSLATE PANEL - ENTRY POINT
// ═══════════════════════════════════════════
async function startTrans() {
  const mA=I('mdlA').value;
  if(!mA){ lg('w','No translation model A set'); return; }
  const raw=I('src').value.trim();
  if(!raw){ lg('w','No source text'); return; }

  I('transBtn').disabled=true; I('stopBtn').disabled=false;
  const ctrl=new AbortController(); S.abort=ctrl;

  // Reset UI
  ['outFinal','outA','outB'].forEach(id=>{ const el=I(id); if(el){el.className='ob';el.textContent='';} });
  I('cf').style.width='0%'; I('arbBadge').style.display='none';
  S.arbData=[];

  const appendTo=(elId,text,first)=>{
    const el=I(elId); if(!el) return;
    el.className='ob';
    if(!first) el.textContent+='\n\n';
    el.textContent+=text;
    el.scrollTop=el.scrollHeight;
    syncScroll(elId);
  };

  try {
    if(S.wf==='seq') {
      // Sequential dual: A full pass → B full pass → G arbitrates
      const mB=I('mdlB').value;
      if(!mB) {
        lg('w','Model B not set - sequential dual needs B. Falling back to single+audit.');
        // Graceful fallback
        I('outpaneA').style.display=''; I('outpaneB').style.display='none';
        I('tpanes').className='tps'; I('outLabel').textContent='Audited output';
        const result=await runSequential(raw, ctrl.signal,
          (c,f)=>appendTo('outA',c,f),
          (c,f)=>appendTo('outFinal',c,f));
        if(!I('mdlG').value) appendTo('outFinal', I('outA').textContent, true);
      } else {
        // Show A and B raw panes + final
        I('outpaneA').style.display=''; I('outpaneB').style.display='';
        I('tpanes').className='tps'; I('arbViewBtn').style.display='';
        I('outLabel').textContent='Arbitrated output';
        await runSeqDual(raw, ctrl.signal,
          (c,f)=>appendTo('outA',c,f),
          (c,f)=>appendTo('outB',c,f),
          (c,f)=>appendTo('outFinal',c,f));
        I('arbBadge').style.display=''; I('arbBadge').textContent='seq. arbitrated';
        if(S.arbData.length) renderArbView();
      }

    } else if(S.wf==='dual') {
      const mB=I('mdlB').value;
      if(!mB){ lg('w','Model B not set for parallel dual'); I('transBtn').disabled=false; I('stopBtn').disabled=true; return; }
      I('outpaneA').style.display=''; I('outpaneB').style.display='';
      I('tpanes').className='tps'; I('arbViewBtn').style.display='';
      I('outLabel').textContent='Arbitrated output';
      const result=await runDual(raw, ctrl.signal,
        (c,f)=>appendTo('outA',c,f),
        (c,f)=>appendTo('outB',c,f));
      appendTo('outFinal', result, true);
      I('arbBadge').style.display=''; I('arbBadge').textContent='parallel arbitrated';
      if(S.arbData.length) renderArbView();

    } else {
      // Single model
      I('outpaneA').style.display='none'; I('outpaneB').style.display='none';
      I('tpanes').className='tps single'; I('arbViewBtn').style.display='none';
      I('outLabel').textContent='Final output';
      await runSequential(raw, ctrl.signal,
        (c,f)=>appendTo('outA',c,f),    // raw goes to hidden pane A
        (c,f)=>appendTo('outFinal',c,f)); // audited goes to final
      // If no audit model, copy raw to final
      if(!I('mdlG').value) appendTo('outFinal', I('outA').textContent, true);
      const hasAudit=!!I('mdlG').value;
      if(hasAudit){ I('arbBadge').style.display=''; I('arbBadge').textContent='audited'; }
    }

    if(!ctrl.signal.aborted) {
      I('cf').style.width='100%'; I('cinfo').textContent='Done';
      setPipeStatus('done');
      S.chunks++; updStats(); saveSt();
      lg('o',`Complete · workflow: ${S.wf}`);
    }
  } catch(e) {
    if(e.name==='AbortError'){ lg('w','Stopped'); setPipeStatus('idle'); }
    else { lg('e', e.message); setPipeStatus('error'); }
  }
  I('transBtn').disabled=false; I('stopBtn').disabled=true;
}

