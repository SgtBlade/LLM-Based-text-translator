function loadEpub(){pickFile('.epub',procEpub);}
function dropEpub(e){e.preventDefault();const f=e.dataTransfer.files[0];if(f?.name.endsWith('.epub'))procEpub(f);}

async function procEpub(file) {
  lg('i',`Loading EPUB: ${file.name} (${(file.size/1024/1024).toFixed(1)} MB)`);
  try {
    if(!window.JSZip) throw new Error('JSZip not loaded');
    const zip=await JSZip.loadAsync(file);
    const containerXml=await zip.file('META-INF/container.xml')?.async('string');
    if(!containerXml) throw new Error('No container.xml - not a valid EPUB');
    const opfPath=containerXml.match(/full-path="([^"]+\.opf)"/)?.[1];
    if(!opfPath) throw new Error('Cannot locate OPF');
    const opfDir=opfPath.includes('/')?opfPath.substring(0,opfPath.lastIndexOf('/')+1):'';
    const opfXml=await zip.file(opfPath)?.async('string');
    if(!opfXml) throw new Error('Cannot read OPF');
    const parser=new DOMParser();
    const opf=parser.parseFromString(opfXml,'text/xml');
    const title=opf.querySelector('title')?.textContent||file.name.replace('.epub','');
    const author=opf.querySelector('creator')?.textContent||'Unknown';
    const lang=opf.querySelector('language')?.textContent||'unknown';
    const publisher=opf.querySelector('publisher')?.textContent||'';
    const description=opf.querySelector('description')?.textContent||'';
    const subject=opf.querySelector('subject')?.textContent||'';
    const rights=opf.querySelector('rights')?.textContent||'';
    const origId=opf.querySelector('identifier')?.textContent||('ts-'+Date.now());
    // Store all metadata for use in dlEpub
    S.epub.origZip = zip;      // keep original zip for clone-and-replace in dlEpub
    S.epub.opfDir  = opfDir;   // e.g. "OEBPS/"
    S.epub.meta = { title, author, lang, publisher, description, subject, rights, origId, titleEn: null };
    // Attempt to translate the book title in the background (non-blocking)
    const koPattern=/[\uAC00-\uD7AF\u3131-\u318F]/;
    if(koPattern.test(title)) {
      const obase=I('obase').value, mdlA_=I('mdlA').value;
      if(mdlA_) {
        fetch(obase+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({model:mdlA_,stream:false,keep_alive:'30m',options:{temperature:0.1,num_ctx:512,num_predict:128},
            messages:[{role:'system',content:'Translate this Korean book title to English. Output ONLY the English title.'},{role:'user',content:title}]})
        }).then(r=>r.json()).then(d=>{
          const en=(d.message?.content||'').trim();
          if(en) { S.epub.meta.titleEn=en; lg('o','Book title translated: '+en); }
        }).catch(()=>{});
      }
    }
    // Cover is preserved automatically - we clone the entire original zip
    I('epMeta').innerHTML=`<strong>${title}</strong><br>Author: ${author} · Language: ${lang}<br>File: ${file.name} · ${(file.size/1024/1024).toFixed(1)} MB · ✓ Original EPUB stored for cloning`;
    const manifest={};
    opf.querySelectorAll('manifest item').forEach(item=>{
      manifest[item.getAttribute('id')]={href:item.getAttribute('href'),type:item.getAttribute('media-type')};
    });
    const spineRefs=[...opf.querySelectorAll('spine itemref')].map(i=>i.getAttribute('idref'));
    S.epub.chapters=[]; let chapNum=0;
    for(const ref of spineRefs) {
      const item=manifest[ref]; if(!item) continue;
      if(!item.type?.includes('html')&&!item.type?.includes('xhtml')) continue;
      const paths=[opfDir+item.href, item.href, item.href.split('../').join('')];
      let rawHtml='';
      for(const p of paths){const f2=zip.file(p);if(f2){rawHtml=await f2.async('string');break;}}
      if(!rawHtml) continue;
      const text=stripHtml(rawHtml);
      if(text.trim().length<10) continue; // skip truly empty pages only
      chapNum++;
      const titleMatch=rawHtml.match(/<h[1-3][^>]*>([^<]+)<\/h[1-3]>/i);
      const chapTitle=titleMatch?titleMatch[1].trim():`Chapter ${chapNum}`;
      S.epub.chapters.push({idx:chapNum-1,id:ref,href:item.href,title:chapTitle,raw:text,
        structural:false, status:'pending',out:''});
    }
    // Select all chapters by default - user can deselect any they don't want
    S.epub.sel=new Set(S.epub.chapters.map((_,i)=>i));
    I('epChCnt').textContent=S.epub.chapters.length;
    I('epInfo').style.display='';
    renderEpList(); renderEpQ();
    I('epqbg').textContent=S.epub.chapters.length;
    lg('o',`EPUB parsed · ${S.epub.chapters.length} chapters`);
  } catch(e){ lg('e','EPUB error: '+e.message); }
}
function stripHtml(html) {
  // ── Step 1: For full XHTML documents, extract <body> content only ──
  // This prevents <head>, <link>, <meta> etc from appearing in extracted text
  const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
  if(bodyMatch) html = bodyMatch[1];

  // ── Step 2: Remove script/style blocks ──
  html = html.replace(/<script[\s\S]*?<\/script>/gi,'')
             .replace(/<style[\s\S]*?<\/style>/gi,'')
             .replace(/<link[^>]*>/gi,'')
             .replace(/<meta[^>]*>/gi,'');

  // ── Step 3: Parse via DOM for clean text extraction ──
  const tmp = document.createElement('div');
  tmp.innerHTML = html;
  // Insert newlines at block boundaries before extracting text
  tmp.querySelectorAll('p,br,h1,h2,h3,h4,h5,h6,li,div,section').forEach(el => {
    el.insertAdjacentText('afterend', '\n');
  });
  let text = (tmp.textContent || tmp.innerText || '').replace(/\n{3,}/g,'\n\n').trim();

  // ── Step 4: Handle pre-escaped HTML entities (e.g. &lt;p&gt; as literal text) ──
  if(text.includes('&lt;') || text.includes('&gt;')) {
    const tmp2 = document.createElement('div'); tmp2.innerHTML = text;
    tmp2.querySelectorAll('p,br,div').forEach(el => el.insertAdjacentText('afterend','\n'));
    text = (tmp2.textContent || tmp2.innerText || '').replace(/\n{3,}/g,'\n\n').trim();
  }

  // ── Step 5: Strip any surviving HTML-like tags (safety net) ──
  text = text.replace(/<[^>]{0,120}>/g, '').replace(/\n{3,}/g,'\n\n').trim();

  // ── Step 6: Remove zero-width / invisible Unicode control characters ──
  // Korean EPUBs sometimes use U+2060 (word joiner) and similar invisible chars
  text = text.replace(/[\u2060-\u2064\u200B-\u200F\uFEFF\u00AD]/g, '');

  return text;
}

// Lightweight stripper for a single chunk - catches anything stripHtml missed
// Called right before sending to the model as a final safety net
function cleanChunkForModel(text) {
  // Remove only clear HTML tags (start with letter/slash, may have attributes)
  // Do NOT remove Korean angle-bracket patterns like <스타더스트!> or <Stardust!>
  // An HTML tag: starts with / or a-z, followed by typical attribute chars
  let t = text.replace(/<(\/)?[a-zA-Z][^>]{0,200}>/g, '');
  // Remove HTML entities that slipped through (literal entity strings, not the characters)
  t = t.replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&');
  // Do NOT replace &lt; / &gt; - they represent < > that survived and should stay as text
  // Remove zero-width / invisible Unicode control characters
  t = t.replace(/[\u2060-\u2064\u200B-\u200F\uFEFF\u00AD]/g, '');
  // Replace non-breaking spaces with regular spaces
  t = t.replace(/\u00a0/g, ' ');
  // Collapse excessive whitespace/newlines
  t = t.replace(/[ \t]{3,}/g, ' ').replace(/\n{3,}/g,'\n\n').trim();
  return t;
}

// Detect if a chapter is purely structural (TOC, colophon, copyright, cover page)
// Returns true if the chapter should be flagged as non-content
function isStructuralChapter(text, title) {
  const t=text.trim();
  // Very short chapters with only a list of chapter names = TOC
  if(t.length<300) {
    const lines=t.split('\n').filter(l=>l.trim());
    // If most lines look like chapter/section titles, it's a TOC
    const tocPattern=/^(chapter|prologue|epilogue|contents?|part|volume|[0-9]+[.。]|제[0-9]+장)/i;
    const tocHits=lines.filter(l=>tocPattern.test(l.trim())).length;
    if(tocHits>=lines.length*0.5 && lines.length>=2) return true;
  }
  // Copyright/colophon pages
  const copyrightPattern=/isbn|copyright|©|all rights reserved|publisher|printed in|first published/i;
  if(copyrightPattern.test(t) && t.length<1500) return true;
  // Pure image/cover pages (almost no text)
  if(t.length<30) return true;
  return false;
}
