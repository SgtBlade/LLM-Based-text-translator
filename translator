// V6: CHUNK VALIDATION & RETRY
// ═══════════════════════════════════════════

// Returns true if the translation output looks valid
function isValidChunkOutput(output, sourceChunk) {
  if (!output || !output.trim()) return false;
  const src = wordCount(sourceChunk || '');
  const out = wordCount(output);
  const ratio = src > 0 ? out / src : 1;
  if (ratio < 0.08 || ratio > 8.0) return false;
  if (/^#{1,3}\s/m.test(output)) return false;           // markdown headers
  if (/^\d+\.\s+\w.*\n.*^\d+\.\s+\w/ms.test(output)) return false; // numbered option lists
  if (/^(here is|here's|below is|the following is).{0,30}translation/im.test(output.slice(0, 150))) return false;
  if (hasRepeatedBlocks(output)) return false;           // model looped and re-emitted earlier content
  return true;
}

// Detects the "repeating blocks" failure mode: a model that loops and
// re-generates a paragraph/sentence it already produced earlier in the
// same output. Checks both exact paragraph duplicates and exact sentence
// duplicates, since loops can happen at either granularity.
//
// Short lines (dialogue, exclamations, refrains) legitimately recur in
// fiction - a character can shout the same battle cry twice, or a line can
// be repeated for rhetorical effect. Long narration blocks essentially never
// repeat verbatim unless something went wrong. So: short paragraphs get one
// free repeat before flagging (matches the sentence-tier tolerance below),
// long paragraphs are flagged on the first repeat.
function hasRepeatedBlocks(output) {
  const paras = output.split(/\r?\n\s*\r?\n/).map(p => p.trim()).filter(p => p.length > 30);
  const paraCounts = {};
  for (const p of paras) paraCounts[p] = (paraCounts[p] || 0) + 1;
  for (const [p, count] of Object.entries(paraCounts)) {
    const isShortLine = p.length < 120; // dialogue/exclamation-length text
    const threshold = isShortLine ? 3 : 2; // short: flag at 3+ (2 is a legit repeat), long: flag at 2+
    if (count >= threshold) return true;
  }
  const sents = (output.match(/[^.!?\u2026]+[.!?\u2026]+/g) || []).map(s => s.trim()).filter(s => s.length > 40);
  const sentCounts = {};
  for (const s of sents) sentCounts[s] = (sentCounts[s] || 0) + 1;
  for (const count of Object.values(sentCounts)) {
    if (count >= 3) return true; // allow 1 legit repeat (2 total), flag 3+
  }
  return false;
}

// chat() wrapper with automatic retry on failed validation
// maxRetries read from settings slider; hard cap at 3 to prevent loops
async function chatWithRetry(model, sys, user, temp, signal, sourceChunk) {
  const maxR = Math.min(parseInt(I('maxRetry')?.value || '1'), 3);
  let lastResult = '';
  for (let attempt = 0; attempt <= maxR; attempt++) {
    if (signal?.aborted) throw new DOMException('Aborted', 'AbortError');
    lastResult = await chat(model, sys, user, temp, signal);
    if (isValidChunkOutput(lastResult, sourceChunk)) return lastResult;
    if (attempt < maxR) {
      lg('w', `Chunk failed validation (attempt ${attempt + 1}/${maxR + 1}) - retrying at lower temperature`);
      temp = Math.max(0.05, temp - 0.15); // slightly lower temp on retry
    }
  }
  // Return last result even if invalid - empty is worse than imperfect
  if (lastResult.trim()) return lastResult;
  return '';
}

// True if the text still contains raw Hangul - i.e. the model left source
// text untranslated instead of rendering it in the target language.
function hasUntranslatedKorean(text) {
  return /[\uac00-\ud7a3]/.test(text || '');
}

// Translates one chunk, and if the result still contains untranslated Korean
// after the normal chatWithRetry attempts, splits JUST THAT CHUNK in half and
// translates each half separately, then rejoins. This is scoped to the one
// problem chunk - it does not change the chunk-size setting for the rest of
// the run. Rationale: a chunk that's too information-dense for the model to
// fully translate in one pass often succeeds once given half as much to do.
async function translateChunkWithFallback(model, chunkSrc, temp, signal, label) {
  let result = await chatWithRetry(model, buildTP(chunkSrc), cleanChunkForModel(chunkSrc), temp, signal, chunkSrc);

  if (hasUntranslatedKorean(result)) {
    lg('w', `${label || 'Chunk'}: untranslated Korean text detected - splitting this chunk in half and retrying`);
    const target = Math.floor(chunkSrc.length / 2);
    const lim = Math.floor(target * 0.5);
    const mid = findBreakPoint(chunkSrc, target, lim);
    const half1 = chunkSrc.slice(0, mid);
    const half2 = chunkSrc.slice(mid);
    const [r1, r2] = await Promise.all([
      chatWithRetry(model, buildTP(half1), cleanChunkForModel(half1), temp, signal, half1),
      chatWithRetry(model, buildTP(half2), cleanChunkForModel(half2), temp, signal, half2)
    ]);
    result = r1 + '\n\n' + r2;
    if (hasUntranslatedKorean(result)) {
      lg('e', `${label || 'Chunk'}: untranslated Korean persisted after split-retry - keeping output, please review this chunk manually`);
    } else {
      lg('o', `${label || 'Chunk'}: resolved by splitting into two smaller requests`);
    }
  }
  return result;
}

// Runs a full translation workflow (single/sequential/dual - whatever
// `workflowFn` wraps) and checks the ASSEMBLED result for duplicated blocks
// that can span across chunk boundaries, which per-chunk validation can't
// catch on its own. If found, retries the entire item from scratch up to
// MAX_WHOLE_ITEM_DUP_RETRIES times. If duplication persists even after that
// (some repetition - a refrain, a repeated battle cry - is legitimate and
// not actually a bug), the result is accepted as-is but flagged, both in the
// log and with a visible warning line prepended to the saved output, rather
// than retrying forever.
const MAX_WHOLE_ITEM_DUP_RETRIES = 1;
async function translateWithDuplicateCheck(workflowFn, label) {
  let out = await workflowFn();
  let attempt = 0;
  while (hasRepeatedBlocks(out) && attempt < MAX_WHOLE_ITEM_DUP_RETRIES) {
    attempt++;
    lg('w', `${label}: duplicated content detected across the assembled output - retrying the entire item (attempt ${attempt}/${MAX_WHOLE_ITEM_DUP_RETRIES})`);
    out = await workflowFn();
  }
  const flagged = hasRepeatedBlocks(out);
  if (flagged) {
    lg('e', `${label}: duplicated content persisted after retry - keeping output but flagging for manual review`);
    out = '[[TRANSLATOR WARNING: possible duplicate content detected in this chapter - please review manually]]\n\n' + out;
  }
  return { out, flagged };
}

// ═══════════════════════════════════════════
// V6: CROSS-CHUNK CONTEXT CARRY
// ═══════════════════════════════════════════

// Extract the last N sentences from a translated chunk to use as context
// for the next chunk's prompt. N comes from the ctxCarry settings slider.
function getContextTail(text) {
  const n = parseInt(I('ctxCarry')?.value || '0');
  if (!n || !text) return '';
  // Split on sentence-ending punctuation; avoid literal newline in regex
  const sents = text.replace(/[\r\n]+/g,' ').match(/[^.!?\u2026]+[.!?\u2026]+\s*/g) || [];
  const tail = sents.slice(-n).join(' ').trim();
  return tail.length > 20 ? tail : '';
}

// Prepend context tail to a user message if context carry is enabled
function withContext(userMsg, contextTail) {
  if (!contextTail) return userMsg;
  return `[Previous context - do not translate, use only for continuity:]
${contextTail}

[Text to translate:]
${userMsg}`;
}




