async function runModelTest() {
  const input = I('testInput')?.value.trim();
  if (!input) { lg('w', 'No test input'); return; }

  const selected = [...document.querySelectorAll('.test-model-cb:checked')].map(cb => cb.value);
  if (!selected.length) { lg('w', 'No models selected for test'); return; }

  const temp      = parseFloat(I('testTemp')?.value || '0.3');
  const chunkSz   = parseInt(I('testChunkSize')?.value || '2000');
  const useDict   = I('testUseDict')?.checked;
  const usePrompt = I('testUsePrompt')?.checked;

  // Truncate input to one chunk for test purposes
  const testChunk = input.length > chunkSz ? input.slice(0, chunkSz) : input;

  const sys = usePrompt ? buildTP(testChunk) : applyLangVars(
    `Translate the following {fromLanguage} text to {toLanguage}. Output only the translation.`
  );
  // If useDict is off, strip the dictionary section from sys
  const finalSys = useDict ? sys : sys.split('\n\nDictionary')[0];

  _testAbort = new AbortController();
  I('testRunBtn').disabled = true;
  I('testStopBtn').disabled = false;
  I('testStatus').textContent = `Testing ${selected.length} model(s)…`;

  // Render placeholder cards
  const grid = I('testGrid');
  grid.innerHTML = selected.map(model => `
    <div class="test-card" id="tc-${model.replace(/[^a-z0-9]/gi,'_')}">
      <div class="test-card-hdr">
        <span>${model}</span>
        <span class="val-badge val-idle" id="tc-badge-${model.replace(/[^a-z0-9]/gi,'_')}">waiting</span>
      </div>
      <div class="test-card-body ph" id="tc-body-${model.replace(/[^a-z0-9]/gi,'_')}">Waiting to start…</div>
      <div class="test-card-stat">
        <span id="tc-stat-${model.replace(/[^a-z0-9]/gi,'_')}">-</span>
        <button class="btn sm" onclick="navigator.clipboard.writeText(I('tc-body-${model.replace(/[^a-z0-9]/gi,'_')}').textContent)" style="padding:.15rem .4rem;font-size:.62rem">⎘</button>
      </div>
    </div>`).join('');

  // Run models sequentially (one at a time - most users have limited VRAM)
  let completed = 0;
  for (const model of selected) {
    if (_testAbort.signal.aborted) break;

    const safeId = model.replace(/[^a-z0-9]/gi, '_');
    const badge  = I('tc-badge-' + safeId);
    const body   = I('tc-body-' + safeId);
    const stat   = I('tc-stat-' + safeId);

    if (badge) badge.textContent = 'running…';
    if (badge) badge.className = 'val-badge val-warn';
    if (body)  { body.className = 'test-card-body ph'; body.textContent = 'Translating…'; }

    const t0 = Date.now();
    try {
      const result = await chat(model, finalSys, cleanChunkForModel(testChunk), temp, _testAbort.signal);
      const elapsed = ((Date.now() - t0) / 1000).toFixed(1);
      const wc = result.trim().split(/\s+/).length;

      if (body)  { body.className = 'test-card-body'; body.textContent = result || '(empty output)'; }
      if (badge) { badge.textContent = '✓ done'; badge.className = 'val-badge val-ok'; }
      if (stat)  stat.textContent = `${elapsed}s · ${wc} words`;

      completed++;
      I('testStatus').textContent = `${completed}/${selected.length} done`;
    } catch(e) {
      if (e.name === 'AbortError') { 
        if (body)  body.textContent = 'Stopped.';
        if (badge) { badge.textContent = 'stopped'; badge.className = 'val-badge'; }
        break;
      }
      if (body)  { body.className = 'test-card-body'; body.textContent = 'Error: ' + e.message; }
      if (badge) { badge.textContent = '✗ error'; badge.className = 'val-badge val-err'; }
      if (stat)  stat.textContent = 'failed';
    }
  }

  I('testRunBtn').disabled = false;
  I('testStopBtn').disabled = true;
  if (!_testAbort.signal.aborted) I('testStatus').textContent = `Done - ${completed}/${selected.length} models tested`;
}

