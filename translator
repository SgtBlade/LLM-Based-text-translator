    const author    = I('ec-author')?.value?.trim()    || '';
    const lang      = I('ec-lang')?.value?.trim()      || 'en';
    const series    = I('ec-series')?.value?.trim()    || '';
    const volume    = I('ec-volume')?.value?.trim()    || '';
    const publisher = I('ec-publisher')?.value?.trim() || '';
    const desc      = I('ec-description')?.value?.trim() || '';
    const tags      = (I('ec-tags')?.value || '').split(',').map(t=>t.trim()).filter(Boolean);
    const bookId    = 'ec-' + Date.now();
    const date      = new Date().toISOString().slice(0, 10);

    const zip = new JSZip();
    zip.file('mimetype', 'application/epub+zip', { compression: 'STORE' });

    // container.xml
    zip.folder('META-INF').file('container.xml',
      '<?xml version="1.0" encoding="UTF-8"?>\n' +
      '<container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container">\n' +
      '  <rootfiles><rootfile full-path="OEBPS/content.opf" media-type="application/oebps-package+xml"/></rootfiles>\n' +
      '</container>');

    const oebps = zip.folder('OEBPS');

    // CSS
    oebps.folder('Styles').file('styles.css',
      'body{font-family:Georgia,"Times New Roman",serif;font-size:1em;line-height:1.8;margin:1.2em 1.8em;color:#1a1a1a;background:#fff}' +
      'h1,h2{font-size:1.3em;margin:0 0 1.2em;padding-bottom:.4em;border-bottom:1px solid #ddd;font-weight:700}' +
      'p{margin:.6em 0;text-indent:1.5em}p:first-of-type,p.noindent{text-indent:0}' +
      'blockquote{border-left:3px solid #ccc;margin:1em 0 1em 1.5em;padding-left:.8em;color:#555}' +
      '.separator{text-align:center;margin:1.5em 0;color:#999}');

    // Cover image
    let coverHref = '';
    let coverManifest = '';
    let coverMeta = '';
    if (EC.coverDataUrl) {
      const base64 = EC.coverDataUrl.split(',')[1];
      const ext    = EC.coverMime === 'image/png' ? 'png' : EC.coverMime === 'image/webp' ? 'webp' : 'jpg';
      coverHref    = `Images/cover.${ext}`;
      // Convert base64 to binary
      const binStr = atob(base64);
      const bytes  = new Uint8Array(binStr.length);
      for (let i = 0; i < binStr.length; i++) bytes[i] = binStr.charCodeAt(i);
      oebps.folder('Images').file(`cover.${ext}`, bytes);
      coverManifest = `\n    <item id="cover-image" href="${coverHref}" media-type="${EC.coverMime}" properties="cover-image"/>`;
      coverMeta     = '\n    <meta name="cover" content="cover-image"/>';

      // Cover page xhtml
      oebps.folder('Text').file('cover.xhtml',
        '<?xml version="1.0" encoding="UTF-8"?>\n' +
        '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">\n' +
        '<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="' + lang + '">\n' +
        '<head><meta charset="UTF-8"/><title>Cover</title>' +
        '<link rel="stylesheet" type="text/css" href="../Styles/styles.css"/></head>\n' +
        '<body style="margin:0;padding:0;text-align:center">\n' +
        `<img src="../${coverHref}" alt="Cover" style="max-width:100%;height:auto"/>\n` +
        '</body></html>');
    }

    // Chapter files
    const manItems  = [];
    const spineItems = [];
    const navPoints  = [];

    if (coverHref) {
      manItems.push('    <item id="cover-page" href="Text/cover.xhtml" media-type="application/xhtml+xml"/>');
      spineItems.push('    <itemref idref="cover-page"/>');
    }

    EC.chapters.forEach((ch, i) => {
      const id   = 'chap' + String(i + 1).padStart(3, '0');
      const fn   = id + '.xhtml';
      // Convert plain text to XHTML paragraphs
      // Handle various paragraph separators and preserve special formatting
      const paragraphs = ch.text
        .replace(/\r\n/g, '\n').replace(/\r/g, '\n')
        .split(/\n{2,}/)
        .map(para => para.trim())
        .filter(para => para.length > 0)
        .map(para => {
          // Detect separator lines (*** or ---) → styled separator
          if (/^[\*\-\s]{3,}$/.test(para)) {
            return '<p class="separator">* * *</p>';
          }
          // Split on single newlines within a paragraph (dialogue lines etc)
          const lines = para.split('\n').map(l => escXml(l.trim())).filter(l => l);
          return '<p>' + lines.join('<br/>') + '</p>';
        })
        .join('\n');

      const xhtml =
        '<?xml version="1.0" encoding="UTF-8"?>\n' +
        '<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">\n' +
        '<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="' + lang + '">\n' +
        '<head><meta charset="UTF-8"/><title>' + escXml(ch.title) + '</title>' +
        '<link rel="stylesheet" type="text/css" href="../Styles/styles.css"/></head>\n' +
        '<body>\n' +
        '<h2>' + escXml(ch.title) + '</h2>\n' +
        paragraphs + '\n' +
        '</body></html>';

      oebps.folder('Text').file(fn, xhtml);
      manItems.push(`    <item id="${id}" href="Text/${fn}" media-type="application/xhtml+xml"/>`);
      spineItems.push(`    <itemref idref="${id}"/>`);
      navPoints.push(
        `    <navPoint id="nav${i+1}" playOrder="${(coverHref?2:1)+i}">\n` +
        `      <navLabel><text>${escXml(ch.title)}</text></navLabel>\n` +
        `      <content src="Text/${fn}"/>\n` +
        `    </navPoint>`
      );
    });

    // OPF
    const subjectItems = tags.map(t => `\n    <dc:subject>${escXml(t)}</dc:subject>`).join('');
    const seriesMeta   = series ? `\n    <meta name="calibre:series" content="${escXml(series)}"/>` +
                                   (volume ? `\n    <meta name="calibre:series_index" content="${escXml(volume)}"/>` : '') : '';
    const volumeTitle  = series && volume ? `${escXml(title)} Vol.${escXml(volume)}` : escXml(title);

    oebps.file('content.opf',
      '<?xml version="1.0" encoding="UTF-8"?>\n' +
      '<package xmlns="http://www.idpf.org/2007/opf" version="2.0" unique-identifier="bookId">\n' +
      '  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">\n' +
      `    <dc:title>${volumeTitle}</dc:title>\n` +
      `    <dc:language>${escXml(lang)}</dc:language>\n` +
      `    <dc:identifier id="bookId">${bookId}</dc:identifier>\n` +
      (author  ? `    <dc:creator opf:role="aut">${escXml(author)}</dc:creator>\n` : '') +
      (publisher?`    <dc:publisher>${escXml(publisher)}</dc:publisher>\n` : '') +
      (desc    ? `    <dc:description>${escXml(desc)}</dc:description>\n` : '') +
      `    <dc:date>${date}</dc:date>` +
      subjectItems + coverMeta + seriesMeta + '\n' +
      '  </metadata>\n' +
      '  <manifest>\n' +
      '    <item id="ncx" href="toc.ncx" media-type="application/x-dtbncx+xml"/>\n' +
      '    <item id="css" href="Styles/styles.css" media-type="text/css"/>' +
      coverManifest + '\n' +
      manItems.join('\n') + '\n' +
      '  </manifest>\n' +
      '  <spine toc="ncx">\n' +
      spineItems.join('\n') + '\n' +
      '  </spine>\n' +
      '</package>');

    // toc.ncx
    const coverNavPoint = coverHref
      ? `    <navPoint id="nav-cover" playOrder="1">\n      <navLabel><text>Cover</text></navLabel>\n      <content src="Text/cover.xhtml"/>\n    </navPoint>\n`
      : '';
    oebps.file('toc.ncx',
      '<?xml version="1.0" encoding="UTF-8"?>\n' +
      '<!DOCTYPE ncx PUBLIC "-//NISO//DTD ncx 2005-1//EN" "http://www.daisy.org/z3986/2005/ncx-2005-1.dtd">\n' +
      '<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1">\n' +
      '  <head>\n' +
      `    <meta name="dtb:uid" content="${bookId}"/>\n` +
      '    <meta name="dtb:depth" content="1"/>\n' +
      '    <meta name="dtb:totalPageCount" content="0"/>\n' +
      '    <meta name="dtb:maxPageNumber" content="0"/>\n' +
      '  </head>\n' +
      `  <docTitle><text>${escXml(title)}</text></docTitle>\n` +
      '  <navMap>\n' +
      coverNavPoint +
      navPoints.join('\n') + '\n' +
      '  </navMap>\n' +
      '</ncx>');

    // Generate and download
    if (status) status.textContent = 'Generating EPUB…';
    const blob = await zip.generateAsync({ type: 'blob', mimeType: 'application/epub+zip' });
    const safeName = title.replace(/[^a-z0-9\u3131-\uD7A3]/gi,'_').replace(/_+/g,'_').slice(0,60).toLowerCase();
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = safeName + '.epub';
    a.click();
    if (status) status.textContent = `✓ Downloaded: ${safeName}.epub (${EC.chapters.length} chapters, ${(blob.size/1024).toFixed(0)} KB)`;

  } catch(e) {
    if (status) status.textContent = '✗ Error: ' + e.message;
    console.error('EPUB Creator build error:', e);
  }
  if (btn) btn.disabled = false;
}

// ── Clear ──
function ec_clearChapters() {
  if (EC.chapters.length && !confirm(`Remove all ${EC.chapters.length} chapter(s)?`)) return;
  EC.chapters = []; ec_renderChapters(); ec_updatePreview();
}
function ec_clear() {
  if (!confirm('Clear all chapters, metadata, and cover image?')) return;
  EC.chapters = []; EC.coverFile = null; EC.coverDataUrl = null;
  ['ec-title','ec-author','ec-series','ec-volume','ec-publisher','ec-description','ec-tags']
    .forEach(id => { const el=I(id); if(el) el.value=''; });
  if(I('ec-lang')) I('ec-lang').value = 'en';
  ec_clearCover();
  ec_renderChapters(); ec_updatePreview();
}

</script>
</body>
</html>
