<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TranslatorStudio V6</title>
<script src="https://unpkg.com/tesseract.js@5/dist/tesseract.min.js"></script>
<script src="https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0f0e0d;--bg2:#161513;--bg3:#1e1c1a;--bg4:#252320;--bg5:#2c2a27;
  --b:rgba(255,255,255,.07);--b2:rgba(255,255,255,.13);
  --tx:#e8e4de;--tx2:#a09890;--tx3:#5c5650;
  --ac:#c8a96e;--ac2:#8b6f42;--ad:rgba(200,169,110,.11);--ad2:rgba(200,169,110,.05);
  --gn:#6db88a;--gd:rgba(109,184,138,.11);
  --rd:#c46b6b;--rdd:rgba(196,107,107,.11);
  --bl:#6b9fc4;--bld:rgba(107,159,196,.11);
  --pu:#9b7ec4;--pud:rgba(155,126,196,.11);
  --tl:#5bb8b0;--tld:rgba(91,184,176,.11);
  --r:6px;--rl:10px;
}
.hidden{display:none;visibility:hidden}
html{font-size:14px}
body{background:var(--bg);color:var(--tx);font-family:'Segoe UI',system-ui,sans-serif;height:100vh;display:flex;flex-direction:column;overflow:hidden}
header{height:48px;border-bottom:1px solid var(--b);padding:0 1.4rem;display:flex;align-items:center;justify-content:space-between;background:var(--bg);z-index:200;flex-shrink:0}
.logo{font-size:.95rem;font-weight:700;color:var(--ac);letter-spacing:.04em}
.pill{display:flex;align-items:center;gap:5px;background:var(--bg3);border:1px solid var(--b);border-radius:20px;padding:3px 10px;font-size:.69rem;color:var(--tx2)}
.dot{width:6px;height:6px;border-radius:50%;background:var(--tx3);transition:background .3s}
.dot.on{background:var(--gn);box-shadow:0 0 5px var(--gn)}
.mbar{height:37px;border-bottom:1px solid var(--b);background:var(--bg2);display:flex;align-items:center;padding:0 1.4rem;gap:1px;flex-shrink:0}
.mb{background:none;border:none;border-bottom:2px solid transparent;color:var(--tx3);font-size:.76rem;font-weight:600;font-family:inherit;padding:0 13px;height:100%;cursor:pointer;transition:all .14s}
.mb:hover{color:var(--tx2)}
.mb.on{color:var(--ac);border-bottom-color:var(--ac)}
.msep{width:1px;height:15px;background:var(--b);margin:0 3px}
.app{display:flex;flex:1;min-height:0}
.sb{width:255px;min-width:255px;background:var(--bg2);border-right:1px solid var(--b);display:flex;flex-direction:column;overflow-y:auto}
.ns{padding:1rem .95rem .32rem;font-size:.59rem;letter-spacing:.14em;text-transform:uppercase;color:var(--tx3);font-weight:700}
.ni{display:flex;align-items:center;gap:7px;padding:.48rem .95rem;cursor:pointer;color:var(--tx2);font-size:.79rem;border-left:2px solid transparent;transition:all .13s}
.ni:hover{color:var(--tx);background:var(--bg3)}
.ni.on{color:var(--ac);border-left-color:var(--ac);background:var(--ad2)}
.nbg{margin-left:auto;font-size:.6rem;background:var(--bg4);border:1px solid var(--b);border-radius:10px;padding:1px 6px;color:var(--tx3);font-family:monospace}
.sf{margin-top:auto;padding:.85rem .95rem;border-top:1px solid var(--b)}
.sr{display:flex;justify-content:space-between;font-size:.68rem;color:var(--tx3);margin-bottom:4px}
.sr span{color:var(--ac);font-family:monospace}
.pb{height:2px;background:var(--bg4);border-radius:2px}
.pf{height:100%;background:var(--ac);border-radius:2px;transition:width .3s}
.main{flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden}
.mc{display:none;flex-direction:column;overflow:hidden}
.mc.on{display:flex;flex:1;min-height:0}
.pn{display:none;flex-direction:column;overflow:hidden}
.pn.on{display:flex;flex:1;min-height:0}
.ph{padding:1rem 1.5rem .75rem;border-bottom:1px solid var(--b);flex-shrink:0}
.pt{font-size:1rem;font-weight:700;margin-bottom:2px}
.ps{font-size:.7rem;color:var(--tx3)}
.pb2{flex:1;overflow-y:auto;padding:1rem 1.5rem;min-height:0}
.card{background:var(--bg3);border:1px solid var(--b);border-radius:var(--rl);padding:.95rem;margin-bottom:.75rem}
.ct{font-size:.61rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--tx3);margin-bottom:.75rem}
.fi{margin-bottom:.72rem}
.fi:last-child{margin-bottom:0}
label{display:block;font-size:.71rem;color:var(--tx2);margin-bottom:3px;font-weight:500}
label .h{font-weight:400;color:var(--tx3)}
input[type=text],input[type=number],select,textarea{width:100%;background:var(--bg4);border:1px solid var(--b);border-radius:var(--r);color:var(--tx);font-family:inherit;font-size:.79rem;padding:.43rem .62rem;outline:none;transition:border-color .13s}
input[type=text]:focus,input[type=number]:focus,select:focus,textarea:focus{border-color:var(--ac2)}
select option{background:var(--bg4)}
textarea{resize:vertical;line-height:1.5;font-size:.76rem;font-family:'Cascadia Code','Fira Mono',monospace}
input[type=range]{width:100%;accent-color:var(--ac);cursor:pointer}
.rr{display:flex;align-items:center;gap:7px}
.rr input{flex:1}
.rv{min-width:40px;text-align:right;font-family:monospace;font-size:.76rem;color:var(--ac)}
.tr{display:flex;align-items:center;justify-content:space-between;gap:10px}
.tog{position:relative;width:31px;height:17px;cursor:pointer;flex-shrink:0}
.tog input{opacity:0;width:0;height:0}
.ts{position:absolute;inset:0;background:var(--bg4);border:1px solid var(--b2);border-radius:20px;transition:.18s}
.ts::after{content:'';position:absolute;width:11px;height:11px;border-radius:50%;left:2px;top:2px;background:var(--tx3);transition:.18s}
.tog input:checked+.ts{background:var(--ad);border-color:var(--ac2)}
.tog input:checked+.ts::after{background:var(--ac);transform:translateX(14px)}
.btn{display:inline-flex;align-items:center;gap:4px;padding:.4rem .85rem;border-radius:var(--r);border:1px solid var(--b2);background:transparent;color:var(--tx2);font-family:inherit;font-size:.74rem;font-weight:600;cursor:pointer;transition:all .13s;white-space:nowrap}
.btn:hover{background:var(--bg4);color:var(--tx)}
.btn.pri{background:var(--ad);border-color:var(--ac2);color:var(--ac)}
.btn.pri:hover{background:rgba(200,169,110,.19)}
.btn.tl{background:var(--tld);border-color:rgba(91,184,176,.3);color:var(--tl)}
.btn.tl:hover{background:rgba(91,184,176,.19)}
.btn.rd{border-color:rgba(196,107,107,.3);color:var(--rd)}
.btn.rd:hover{background:var(--rdd)}
.btn.sm{padding:.26rem .58rem;font-size:.68rem}
.btn:disabled{opacity:.35;cursor:not-allowed}
.br{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
/* text panes */
.tps{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.7rem;flex:1;min-height:0}
.tps.single{grid-template-columns:1fr 1fr}
.tp{display:flex;flex-direction:column;background:var(--bg3);border:1px solid var(--b);border-radius:var(--rl);overflow:hidden}
.tph{padding:.5rem .82rem;border-bottom:1px solid var(--b);display:flex;align-items:center;justify-content:space-between;font-size:.63rem;text-transform:uppercase;letter-spacing:.09em;color:var(--tx3);font-weight:700;flex-shrink:0}
.tpx{flex:1;border:none;border-radius:0;background:transparent;resize:none;padding:.82rem;font-size:.86rem;line-height:1.75;color:var(--tx);font-family:Georgia,serif}
.tpx:focus{outline:none}
.ob{flex:1;padding:.82rem;overflow-y:auto;font-family:Georgia,serif;font-size:.87rem;line-height:1.8;color:var(--tx);white-space:pre-wrap}
.ob.ph{color:var(--tx3);font-style:italic;font-size:.77rem}
/* sentence arbitration view */
.sarb-wrap{flex:1;overflow-y:auto;padding:.7rem}
.sarb-sent{margin-bottom:.6rem;border-radius:var(--r);overflow:hidden;border:1px solid var(--b)}
.sarb-opts{display:grid;grid-template-columns:1fr 1fr}
.sarb-opt{padding:.5rem .7rem;font-size:.78rem;font-family:Georgia,serif;line-height:1.55;color:var(--tx2);cursor:pointer;transition:all .12s;border-right:1px solid var(--b)}
.sarb-opt:last-child{border-right:none}
.sarb-opt:hover{background:var(--bg5);color:var(--tx)}
.sarb-opt.sel{background:var(--ad2);color:var(--tx);border-color:var(--ac2)}
.sarb-opt.auto{background:var(--gd)}
.sarb-label{font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;font-family:sans-serif;margin-bottom:3px;opacity:.6}
/* chunk progress */
.cbar{height:3px;background:var(--bg4);border-radius:2px;overflow:hidden;margin-bottom:5px;flex-shrink:0}
.cf{height:100%;background:var(--ac);transition:width .25s}
/* queue */
.qi{display:flex;align-items:center;gap:8px;padding:.58rem .82rem;background:var(--bg3);border:1px solid var(--b);border-radius:var(--r);margin-bottom:.38rem}
.qd{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.q-p{background:var(--tx3)}.q-r{background:var(--ac);animation:blink 1s infinite}.q-d{background:var(--gn)}.q-e{background:var(--rd)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
.qn{flex:1;font-size:.77rem}
.qm{font-size:.66rem;color:var(--tx3);font-family:monospace}
/* epub */
.epl{max-height:280px;overflow-y:auto;border:1px solid var(--b);border-radius:var(--r)}
.epi{display:flex;align-items:center;gap:7px;padding:.42rem .72rem;border-bottom:1px solid var(--b);font-size:.74rem;cursor:pointer;transition:background .11s}
.epi:last-child{border-bottom:none}
.epi:hover{background:var(--bg4)}
.epi.sel{background:var(--ad2);color:var(--ac)}
.epn{font-family:monospace;font-size:.63rem;color:var(--tx3);min-width:26px}
.eps{margin-left:auto;font-size:.62rem;padding:1px 6px;border-radius:8px}
.es-w{background:var(--bg4);color:var(--tx3)}.es-r{background:var(--ad);color:var(--ac)}.es-d{background:var(--gd);color:var(--gn)}.es-e{background:var(--rdd);color:var(--rd)}
/* dict */
.dt{width:100%;border-collapse:collapse;font-size:.76rem}
.dt th{text-align:left;padding:.4rem .6rem;font-size:.6rem;text-transform:uppercase;letter-spacing:.09em;color:var(--tx3);font-weight:700;border-bottom:1px solid var(--b)}
.dt td{padding:.4rem .6rem;border-bottom:1px solid var(--b);color:var(--tx2)}
.dt td:first-child{font-family:monospace;color:var(--tx)}
.dt tr:last-child td{border-bottom:none}
.dt tr:hover td{background:var(--bg4)}
/* webtoon */
.wtw{display:flex;gap:.75rem;flex:1;min-height:0}
.wcw{flex:1;min-width:0;background:var(--bg3);border:1px solid var(--b);border-radius:var(--rl);display:flex;flex-direction:column;overflow:hidden}
.wtb{padding:.48rem .82rem;border-bottom:1px solid var(--b);display:flex;align-items:center;gap:5px;flex-shrink:0;flex-wrap:wrap;background:var(--bg4)}
.cc{flex:1;overflow:auto;display:flex;align-items:flex-start;justify-content:center;padding:.7rem;background:#080808}
canvas{display:block;cursor:crosshair}
.wsb{width:265px;min-width:265px;display:flex;flex-direction:column;gap:.75rem;overflow-y:auto}
.ri{display:flex;align-items:flex-start;gap:6px;padding:.48rem .62rem;background:var(--bg3);border:1px solid var(--b);border-radius:var(--r);margin-bottom:.32rem;cursor:pointer;transition:border-color .12s}
.ri:hover{border-color:var(--b2)}
.ri.on{border-color:var(--ac2);background:var(--ad2)}
.rn{font-family:monospace;font-size:.61rem;color:var(--tx3);min-width:15px}
.rt{flex:1;font-size:.7rem;color:var(--tx2);line-height:1.33;word-break:break-all}
.rst{font-size:.61rem;padding:1px 5px;border-radius:6px;white-space:nowrap;flex-shrink:0}
.rs-p{background:var(--bg5);color:var(--tx3)}.rs-o{background:var(--bld);color:var(--bl)}.rs-t{background:var(--gd);color:var(--gn)}
.tb{display:inline-flex;align-items:center;gap:3px;padding:.25rem .58rem;border-radius:var(--r);border:1px solid var(--b);background:var(--bg4);color:var(--tx2);font-size:.69rem;cursor:pointer;font-family:inherit;transition:all .12s}
.tb:hover{border-color:var(--b2);color:var(--tx)}
.tb.on{border-color:var(--ac2);background:var(--ad);color:var(--ac)}
.iopt{display:flex;align-items:flex-start;gap:7px;padding:.42rem .67rem;border:1px solid var(--b);border-radius:var(--r);cursor:pointer;transition:all .12s;font-size:.74rem;color:var(--tx2);margin-bottom:.35rem}
.iopt:hover{border-color:var(--b2);background:var(--bg4)}
.iopt.on{border-color:var(--ac2);background:var(--ad2);color:var(--tx)}
.iopt input[type=radio]{accent-color:var(--ac);margin-top:2px;flex-shrink:0}
.il{font-weight:600;font-size:.72rem}
.is{font-size:.67rem;color:var(--tx3);margin-top:1px}
/* misc */
.sep{height:1px;background:var(--b);margin:.85rem 0}
.log{background:var(--bg);border:1px solid var(--b);border-radius:var(--r);padding:.58rem .68rem;font-family:monospace;font-size:.67rem;line-height:1.6;color:var(--tx3);max-height:120px;overflow-y:auto}
.li{color:var(--bl)}.lo{color:var(--gn)}.lw{color:var(--ac)}.le{color:var(--rd)}
.notice{background:var(--ad2);border:1px solid rgba(200,169,110,.16);border-radius:var(--r);padding:.58rem .82rem;font-size:.71rem;color:var(--ac);margin-bottom:.75rem}
.notice.tl{background:var(--tld);border-color:rgba(91,184,176,.2);color:var(--tl)}
.notice.gn{background:var(--gd);border-color:rgba(109,184,138,.2);color:var(--gn)}
.empty{text-align:center;padding:1.8rem;color:var(--tx3);font-size:.79rem}
.emico{font-size:1.6rem;margin-bottom:.38rem;opacity:.22}
::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--bg5);border-radius:2px}
/* dual model status bar */
.dbar{display:flex;gap:.5rem;margin-bottom:.6rem;flex-shrink:0}
.dcard{flex:1;background:var(--bg4);border:1px solid var(--b);border-radius:var(--r);padding:.48rem .65rem}
.dlbl{font-size:.59rem;text-transform:uppercase;letter-spacing:.08em;color:var(--tx3);margin-bottom:2px;display:flex;align-items:center;gap:5px}
.dval{font-size:.73rem;color:var(--tx);font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{display:inline-flex;align-items:center;font-size:.58rem;padding:1px 6px;border-radius:8px;font-weight:600}
.ba{background:var(--bld);color:var(--bl)}.bb{background:var(--pud);color:var(--pu)}.bg{background:var(--gd);color:var(--gn)}
/* arbitration mode toggle */
.arbmode{display:flex;gap:4px;margin-bottom:.65rem}
.amopt{flex:1;padding:.38rem .5rem;border:1px solid var(--b);border-radius:var(--r);font-size:.69rem;font-weight:600;text-align:center;cursor:pointer;color:var(--tx3);background:var(--bg4);transition:all .12s}
.amopt.on{border-color:var(--ac2);background:var(--ad);color:var(--ac)}

/* workflow picker */
.wfpick{display:flex;gap:.5rem;margin-bottom:.75rem;flex-shrink:0}
.wfopt{flex:1;padding:.55rem .7rem;border:1px solid var(--b);border-radius:var(--rl);cursor:pointer;transition:all .14s;text-align:left;background:var(--bg3)}
.wfopt:hover{border-color:var(--b2);background:var(--bg4)}
.wfopt.on{border-color:var(--ac2);background:var(--ad2)}
.wfopt-title{font-size:.74rem;font-weight:700;color:var(--tx);margin-bottom:2px;display:flex;align-items:center;gap:6px}
.wfopt-sub{font-size:.65rem;color:var(--tx3);line-height:1.4}
.wfopt.on .wfopt-title{color:var(--ac)}
/* pipeline status strip */
.pipe-strip{display:flex;align-items:center;gap:0;margin-bottom:.65rem;flex-shrink:0;border:1px solid var(--b);border-radius:var(--rl);overflow:hidden;background:var(--bg3)}
.pipe-step{flex:1;padding:.45rem .65rem;font-size:.68rem;color:var(--tx3);border-right:1px solid var(--b);text-align:center;transition:all .2s}
.pipe-step:last-child{border-right:none}
.pipe-step.active{background:var(--ad);color:var(--ac);font-weight:700}
.pipe-step.done{background:var(--gd);color:var(--gn)}
.pipe-step.err{background:var(--rdd);color:var(--rd)}
.pipe-label{font-size:.6rem;opacity:.6;display:block;margin-bottom:1px}
/* audit diff coloring */
.aud-wrap{flex:1;overflow-y:auto;padding:.7rem;font-family:Georgia,serif;font-size:.87rem;line-height:1.8;white-space:pre-wrap;color:var(--tx)}


/* scroll sync snap button */
.snap-btn{position:absolute;bottom:6px;right:6px;z-index:10;padding:.22rem .55rem;font-size:.63rem;opacity:.55;transition:opacity .15s}
.snap-btn:hover{opacity:1}
.tpane-wrap{position:relative}
/* detailed status bar */
.status-bar{display:flex;align-items:center;gap:0;background:var(--bg4);border:1px solid var(--b);border-radius:var(--r);overflow:hidden;margin-bottom:.55rem;flex-shrink:0;font-family:monospace;font-size:.67rem}
.sb-cell{padding:.3rem .65rem;border-right:1px solid var(--b);color:var(--tx3);white-space:nowrap}
.sb-cell:last-child{border-right:none}
.sb-cell .sbl{font-size:.57rem;text-transform:uppercase;letter-spacing:.07em;opacity:.55;display:block;margin-bottom:1px}
.sb-cell .sbv{color:var(--tx)}
.sb-cell.warn .sbv{color:var(--lw)}
.sb-cell.ok .sbv{color:var(--gn)}
.sb-cell.err .sbv{color:var(--rd)}
.sb-cell.active .sbv{color:var(--ac)}
.sb-flex{flex:1}
/* heartbeat dot */
.hb{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--tx3);margin-right:5px;vertical-align:middle;transition:background .3s}
.hb.pulse{background:var(--ac);animation:hbpulse .6s ease-out}
@keyframes hbpulse{0%{transform:scale(1.6);opacity:1}100%{transform:scale(1);opacity:.7}}


/* epub multi-queue */
.epq-item{display:flex;align-items:center;gap:9px;padding:.55rem .85rem;background:var(--bg3);border:1px solid var(--b);border-radius:var(--r);margin-bottom:.38rem}
.epq-name{flex:1;font-size:.78rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.epq-sub{font-size:.67rem;color:var(--tx3);font-family:monospace;white-space:nowrap}
.epq-status{font-size:.65rem;padding:1px 7px;border-radius:8px;white-space:nowrap;flex-shrink:0}
.epq-idle{background:var(--bg4);color:var(--tx3)}
.epq-active{background:var(--ad);color:var(--ac);animation:blink 1s infinite}
.epq-done{background:var(--gd);color:var(--gn)}
.epq-err{background:var(--rdd);color:var(--rd)}
/* epub progress strip */
.ep-prog{background:var(--bg4);border:1px solid var(--b);border-radius:var(--r);padding:.55rem .85rem;margin-bottom:.65rem;font-size:.72rem;font-family:monospace}
.ep-prog-row{display:flex;justify-content:space-between;margin-bottom:3px;color:var(--tx3)}
.ep-prog-row span{color:var(--tx2)}
.ep-cbar{height:3px;background:var(--bg5);border-radius:2px;overflow:hidden;margin-top:4px}
.ep-cfill{height:100%;background:var(--ac);border-radius:2px;transition:width .25s}
/* request log panel */
.req-log{background:var(--bg);border:1px solid var(--b);border-radius:var(--r);font-family:monospace;font-size:.67rem;max-height:240px;overflow-y:auto}
.req-entry{border-bottom:1px solid var(--b);padding:.45rem .65rem}
.req-entry:last-child{border-bottom:none}
.req-ts{color:var(--tx3);margin-right:6px}
.req-model{color:var(--ac);margin-right:6px}
.req-in{color:var(--bl);white-space:pre-wrap;word-break:break-all;max-height:60px;overflow:hidden;cursor:pointer}
.req-out{color:var(--gn);white-space:pre-wrap;word-break:break-all;max-height:60px;overflow:hidden;cursor:pointer}
.req-err{color:var(--rd)}
.req-entry.expanded .req-in,.req-entry.expanded .req-out{max-height:none}


/* validation */
.val-badge{display:inline-flex;align-items:center;gap:3px;font-size:.62rem;padding:1px 6px;border-radius:6px;font-weight:600;margin-left:5px}
.val-ok{background:var(--gd);color:var(--gn)}
.val-warn{background:rgba(255,193,7,.15);color:#ffc107}
.val-err{background:var(--rdd);color:var(--rd)}
.val-report{background:var(--bg3);border:1px solid var(--b);border-radius:var(--rl);margin-bottom:.75rem;overflow:hidden}
.val-report-hdr{padding:.55rem .85rem;background:var(--bg4);border-bottom:1px solid var(--b);display:flex;align-items:center;justify-content:space-between;font-size:.72rem;font-weight:700}
.val-section{padding:.65rem .85rem;border-bottom:1px solid var(--b)}
.val-section:last-child{border-bottom:none}
.val-row{display:flex;justify-content:space-between;align-items:center;font-size:.73rem;padding:2px 0}
.val-label{color:var(--tx2)}
.val-value{font-family:monospace;font-size:.7rem;color:var(--tx)}
