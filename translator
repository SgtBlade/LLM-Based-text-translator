    const ctx=S.wt.ctx; ctx.strokeStyle='#c8a96e'; ctx.lineWidth=2/S.wt.scale;
    ctx.setLineDash([6/S.wt.scale,3/S.wt.scale]); ctx.strokeRect(x,y,w,h); ctx.setLineDash([]);
  };
  cv.onmouseup=e=>{
    if(!S.wt.drawing)return; S.wt.drawing=false; const p=wt_cp(e);
    const x=Math.min(S.wt.sx,p.x),y=Math.min(S.wt.sy,p.y),w=Math.abs(p.x-S.wt.sx),h=Math.abs(p.y-S.wt.sy);
