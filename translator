async function extractTerminology(sampleText) {
  const mdlA = I('mdlA').value;
  if (!mdlA) { lg('w', 'Set Model A to use terminology extraction'); return; }
  const from = I('fromLang')?.value || 'Korean';
  const to   = I('toLang')?.value   || 'English';
  lg('i', `Extracting terminology from sample text (${from})…`);

  const sys = `You are a terminology extractor for ${from}-to-${to} translation. 
Extract ALL proper nouns, character names, place names, skill/ability names, organization names, and world-specific terms from the text.
Return ONLY a JSON array. Each item: {"k":"${from} term","e":"suggested ${to} translation","n":"optional note"}.
If you are unsure of the translation, give your best guess. No explanation, no markdown, just the JSON array.`;

  try {
    const raw = await chat(mdlA, sys, sampleText.slice(0, 3000), 0.2);
    // Strip any markdown fences
    const clean = raw.replace(/```json\n?|```/g, '').trim();
    const terms = JSON.parse(clean);
    if (!Array.isArray(terms)) throw new Error('Not an array');
    renderTermSuggestions(terms.filter(t => t.k && t.e));
    lg('o', `Terminology extraction: ${terms.length} term(s) found`);
  } catch(e) {
    lg('e', 'Terminology extraction failed: ' + e.message);
    I('termPanel').style.display = 'none';
  }
}

function renderTermSuggestions(terms) {
  const panel = I('termPanel');
  const list  = I('termList');
  if (!panel || !list) return;
  if (!terms.length) { panel.style.display = 'none'; return; }

  // Filter out terms already in dictionary
  const existing = new Set(S.dict.map(d => d.k));
  const novel = terms.filter(t => !existing.has(t.k));
  if (!novel.length) { lg('i', 'All extracted terms already in dictionary'); panel.style.display = 'none'; return; }

  list.innerHTML = novel.map((t, i) => `
    <div class="term-card" id="tcard-${i}">
      <span class="term-ko">${escXml(t.k)}</span>
      <span class="term-arrow">→</span>
      <span class="term-en">${escXml(t.e)}</span>
      ${t.n ? `<span style="color:var(--tx3);font-size:.65rem">(${escXml(t.n)})</span>` : ''}
      <button class="btn sm" onclick="addTermSuggestion(${i})" style="margin-left:auto">+</button>
    </div>`).join('');

  // Store for later
  panel._terms = novel;
  panel.style.display = '';
}

function addTermSuggestion(i) {
  const panel = I('termPanel');
  const term  = panel._terms?.[i];
  if (!term) return;
  S.dict.push({ k: term.k, e: term.e, n: term.n || '' });
  saveSt(); renderDict(); updDP();
  const card = I('tcard-' + i);
  if (card) { card.style.opacity = '0.4'; card.querySelector('.btn').textContent = '✓'; card.querySelector('.btn').disabled = true; }
  lg('o', `Added: ${term.k} → ${term.e}`);
}

function addAllTermSuggestions() {
  const panel = I('termPanel');
  const terms = panel._terms || [];
  let added = 0;
  terms.forEach((t, i) => {
    if (S.dict.some(d => d.k === t.k)) return;
    S.dict.push({ k: t.k, e: t.e, n: t.n || '' });
    added++;
    addTermSuggestion(i); // visual feedback
  });
  saveSt(); renderDict(); updDP();
  lg('o', `Added ${added} term(s) to dictionary`);
}

