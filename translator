// Track timing for EPUB chunk ETA
const _epTiming = { chunkTimes:[], lastChunkStart:null };

function epProgStart(chapTitle, chapIdx, totalChaps) {
  _epTiming.chunkTimes = []; _epTiming.lastChunkStart = null;
  const s = I('epProgStrip'); if(s) s.style.display = '';
  const b = I('epBatchProg'); if(b) b.style.display = '';
  if(I('epProgChap'))  I('epProgChap').textContent  = `${chapTitle} (${chapIdx+1}/${totalChaps})`;
  if(I('epBatchChap')) I('epBatchChap').textContent = `${chapTitle} (${chapIdx+1}/${totalChaps})`;
  epProgChunk(0, 1, 'Translating');
}

function epProgChunk(chunkIdx, totalChunks, phase) {
  _epTiming.lastChunkStart = Date.now();
  const pct = totalChunks > 0 ? Math.round((chunkIdx / totalChunks) * 100) : 0;
  if(I('epProgBar'))   I('epProgBar').style.width   = pct + '%';
  if(I('epBatchBar'))  I('epBatchBar').style.width  = pct + '%';
  if(I('epProgChunk')) I('epProgChunk').textContent = `${chunkIdx+1}/${totalChunks}`;
  if(I('epBatchChunk'))I('epBatchChunk').textContent= `${chunkIdx+1}/${totalChunks}`;
  if(I('epProgPhase')) I('epProgPhase').textContent = phase || '-';
}

function epProgChunkDone() {
  if(_epTiming.lastChunkStart) {
    _epTiming.chunkTimes.push(Date.now() - _epTiming.lastChunkStart);
    if(_epTiming.chunkTimes.length > 6) _epTiming.chunkTimes.shift();
  }
  _updateEpEta();
}

function _updateEpEta(chunksLeft) {
  if(!_epTiming.chunkTimes.length) return;
  const avg = _epTiming.chunkTimes.reduce((a,b)=>a+b,0) / _epTiming.chunkTimes.length;
  const eta = chunksLeft !== undefined ? _fmtSecs(avg * chunksLeft) : '-';
  if(I('epProgEta'))  I('epProgEta').textContent  = eta;
  if(I('epBatchEta')) I('epBatchEta').textContent = eta;
}

function epProgDone() {
  if(I('epProgBar'))   I('epProgBar').style.width   = '100%';
  if(I('epBatchBar'))  I('epBatchBar').style.width  = '100%';
  if(I('epProgChunk')) I('epProgChunk').textContent = 'Done ✓';
  if(I('epBatchChunk'))I('epBatchChunk').textContent= 'Done ✓';
  if(I('epProgEta'))   I('epProgEta').textContent   = '-';
}

