async function dlEpub() {
  const done = S.epub.chapters.filter(c => c.status === 'done');
  if (!done.length) { lg('w', 'No chapters translated yet'); return; }
  if (!window.JSZip) { lg('e', 'JSZip not loaded'); return; }
  if (!S.epub.origZip) { lg('e', 'Original EPUB zip not stored - please re-load the EPUB'); return; }

  lg('i', `Building translated EPUB from original - replacing ${done.length} chapter(s)…`);

  try {
    // ── Clone the original ZIP byte-for-byte ──
    const zip = await S.epub.origZip.generateAsync({ type: 'arraybuffer' })
      .then(buf => JSZip.loadAsync(buf));

    // Build a lookup: chapter object → original file path in the zip
    // S.epub.chapters[i].href is the href relative to the OPF dir
    const opfDir = S.epub.opfDir || 'OEBPS/';

    // For each translated chapter, replace only the <body> content in the original file
    for (const ch of done) {
      // Skip if translation output is empty - keep original file unchanged
      if (!ch.out || !ch.out.trim()) {
        lg('w', `Skipping "${ch.title}" - translation output is empty, original preserved`);
        continue;
      }
      const filePath = opfDir + ch.href;
      const altPath  = ch.href; // some EPUBs have href relative to root

      const zipFile = zip.file(filePath) || zip.file(altPath);
      if (!zipFile) {
        lg('w', `Cannot find original file for "${ch.title}" (tried ${filePath})`);
        continue;
      }

      const origHtml = await zipFile.async('string');

      // Build replacement body content from translated text
      // Each paragraph becomes a <p> tag matching the original style
      const newParagraphs = ch.out
        .split(/\n{2,}/)
        .map(para => para.trim())
        .filter(para => para.length > 0)
        .flatMap(para =>
          para.split(/\n/)
            .map(line => line.trim())
            .filter(line => line.length > 0)
            .map(line => `<p>${escXml(line)}</p>`)
        )
        .join('\n');

      // Extract the chapter heading from the original (h1, h2, h3)
      const origHeadingMatch = origHtml.match(/<h[1-3][^>]*>([\s\S]*?)<\/h[1-3]>/i);
      const origHeading = origHeadingMatch ? origHeadingMatch[0] : '';

      // Replace the <body>...</body> content entirely, preserving the heading
      const newBody = origHeading
        ? `<body>\n  <p>&nbsp;</p>\n\n  ${origHeading}\n\n  <p>&nbsp;</p>\n\n${newParagraphs}\n</body>`
        : `<body>\n${newParagraphs}\n</body>`;

      const newHtml = origHtml.replace(/<body[\s\S]*<\/body>/i, newBody);
      zip.file(zipFile.name, newHtml);
      lg('o', `Replaced: ${ch.href}`);
    }

    // ── Generate and download ──
    const blob = await zip.generateAsync({
      type: 'blob',
      mimeType: 'application/epub+zip',
      compression: 'DEFLATE',
      compressionOptions: { level: 6 }
    });
    // mimetype must be uncompressed - re-add it
    const finalZip = await JSZip.loadAsync(await blob.arrayBuffer());
    // JSZip doesn't guarantee mimetype is first or uncompressed in the above
    // Rebuild properly: mimetype first uncompressed, rest normal
    const outZip = new JSZip();
    outZip.file('mimetype', 'application/epub+zip', { compression: 'STORE' });
    const entries = Object.keys(finalZip.files).filter(n => n !== 'mimetype');
    for (const name of entries) {
      const entry = finalZip.files[name];
      if (entry.dir) { outZip.folder(name); continue; }
      const data = await entry.async('arraybuffer');
      outZip.file(name, data);
    }

    const finalBlob = await outZip.generateAsync({
      type: 'blob',
      mimeType: 'application/epub+zip'
    });

    const safeName = (S.epub.meta?.title || 'translated')
      .replace(/[^a-z0-9\u3131-\uD7A3]/gi, '_')
      .replace(/_+/g, '_')
      .slice(0, 60);

    // ── Run validation if enabled ──
    if(I('doValidate')?.checked) {
      lg('i', 'Running output validation…');
      const report = await validateEpubOutput(
        S.epub.chapters,
        done,
        S.epub.meta,
        S.epub.meta  // same object - we're checking internal consistency
      );
      renderValReport(report);
      if(!report.passed) {
        lg('w', `Validation: ${report.summary.warn} warning(s), ${report.summary.err} error(s) - see report above queue · downloading anyway`);
      } else {
        lg('o', 'Validation: all checks passed ✓');
      }
    }

    const a = document.createElement('a');
    a.href = URL.createObjectURL(finalBlob);
    a.download = safeName + '_en.epub';
    a.click();
    lg('o', `EPUB downloaded · ${done.length} chapter(s) replaced · all original metadata/assets preserved`);

  } catch(e) {
    lg('e', 'EPUB build error: ' + e.message);
    console.error(e);
  }
}

function escXml(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;');}

