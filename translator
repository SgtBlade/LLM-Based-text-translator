// ═══════════════════════════════════════════
// SYNCHRONIZED SCROLLING
// ═══════════════════════════════════════════
let _syncLock = false;      // prevents re-entrant scroll events
let _lastScrollSource = 'outFinal'; // tracks which pane was last scrolled

function isVisible(el) {
  // Check the pane wrapper (.tp) is not hidden, not just the element itself
  if (!el) return false;
  const pane = el.closest('.tp');
  if (!pane) return false;
  // offsetParent is null when display:none
  if (pane.offsetParent === null) return false;
  // Also check inline style on parent
  if (pane.style.display === 'none') return false;
  return true;
}

function syncScroll(sourceId) {
  if (_syncLock) return;
  const sourceEl = I(sourceId);
  if (!sourceEl || !isVisible(sourceEl)) return;

  const maxScroll = sourceEl.scrollHeight - sourceEl.clientHeight;
  if (maxScroll <= 0) return; // not scrollable, skip

  const ratio = sourceEl.scrollTop / maxScroll;
  _lastScrollSource = sourceId;
  _syncLock = true;

  requestAnimationFrame(() => {
    ['src','outA','outB','outFinal'].forEach(id => {
      if (id === sourceId) return;
      const el = I(id);
      if (!el || !isVisible(el)) return;
      const targetMax = el.scrollHeight - el.clientHeight;
      if (targetMax <= 0) return;
      el.scrollTop = ratio * targetMax;
    });
    // Small delay before releasing lock to absorb the scroll events the above triggers
    setTimeout(() => { _syncLock = false; }, 60);
  });
}

// Snap all panes to the same scroll ratio as the last-focused pane
function snapScroll() {
  const sourceEl = I(_lastScrollSource);
  if (!sourceEl) return;
  _syncLock = false; // force-release lock in case it got stuck
  syncScroll(_lastScrollSource);
  // Brief visual feedback on snap button
  const btn = I('snapBtn');
  if (btn) { btn.textContent = '✓ Snapped'; setTimeout(() => { btn.textContent = '⤢ Snap'; }, 1000); }
}

function setupScrollSync() {
  ['src','outA','outB','outFinal'].forEach(id => {
    const el = I(id);
    if (!el) return;
    el.addEventListener('scroll', () => {
      if (!_syncLock) syncScroll(id);
    }, { passive: true });
    // Track focus so snapScroll knows which pane to use as reference
    el.addEventListener('mouseenter', () => { _lastScrollSource = id; });
  });
}

