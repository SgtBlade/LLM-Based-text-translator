// Each entry: { file, name, status, chapCount, translatedChaps, error }
const _epBatch = [];
let _epBatchRunning = false;

function epBatchAdd() {
  const inp = document.createElement('input');
  inp.type = 'file'; inp.multiple = true; inp.accept = '.epub';
  inp.onchange = e => {
    for(const f of Array.from(e.target.files)) {
      _epBatch.push({ file: f, name: f.name, status: 'pending', chapCount: 0, translatedChaps: 0, error: null });
    }
    renderEpBatch();
    lg('i', `Added ${e.target.files.length} EPUB(s) to batch queue`);
  };
  inp.click();
}

async function runEpBatch() {
  const mdlA = I('mdlA').value;
  if(!mdlA) { lg('w', 'No translation model set'); return; }
  if(_epBatchRunning) return;
  _epBatchRunning = true;
  const btn = I('epBatchRunBtn'); if(btn) btn.disabled = true;
  I('epBatchProg').style.display = '';

  for(let i = 0; i < _epBatch.length; i++) {
    const item = _epBatch[i];
    if(item.status !== 'pending') continue;
    item.status = 'active'; renderEpBatch();
    I('epBatchBook').textContent = item.name + ` (${i+1}/${_epBatch.length})`;
    lg('i', `Batch: loading ${item.name}…`);

    try {
      // Load the EPUB
      await procEpub(item.file);
      item.chapCount = S.epub.chapters.length;

      // Select all non-structural chapters
      S.epub.sel = new Set(S.epub.chapters.map((_,j)=>j).filter(j=>!S.epub.chapters[j].structural));
      lg('i', `Batch: ${item.name} - ${S.epub.sel.size} content chapters`);

      // Translate all selected chapters using the enhanced runEpQ with progress
      await runEpQWithProgress(item);

      // Auto-download
      lg('i', `Batch: downloading ${item.name}…`);
      await dlEpub();
      item.status = 'done'; item.translatedChaps = S.epub.chapters.filter(c=>c.status==='done').length;
      lg('o', `Batch: ${item.name} done (${item.translatedChaps} chapters)`);
    } catch(e) {
      item.status = 'err'; item.error = e.message;
      lg('e', `Batch: ${item.name} failed - ${e.message}`);
    }

    // Clear EPUB from memory before next
    S.epub = { chapters:[], sel:new Set(), _prev:-1, meta:null, origZip:null, opfDir:'' };
    renderEpList(); renderEpQ();
    renderEpBatch();

    // Brief pause before next
    if(i < _epBatch.length - 1) await sleep(1500);
  }

  _epBatchRunning = false;
  if(btn) btn.disabled = false;
  I('epBatchProg').style.display = 'none';
  lg('o', `Batch complete - ${_epBatch.filter(b=>b.status==='done').length}/${_epBatch.length} successful`);
}

function renderEpBatch() {
  const el = I('epBatchList');
  if(!_epBatch.length) { el.innerHTML = '<div class="empty"><div class="emico">📚</div>No EPUBs queued.</div>'; return; }
  el.innerHTML = _epBatch.map((item,i) => `
    <div class="epq-item">
      <div class="epq-name">${item.name}</div>
      ${item.chapCount ? `<div class="epq-sub">${item.translatedChaps}/${item.chapCount} chaps</div>` : ''}
      <div class="epq-status epq-${item.status==='pending'?'idle':item.status==='active'?'active':item.status==='done'?'done':'err'}">
        ${item.status==='err'?'✗ '+item.error.slice(0,30):item.status}
      </div>
      ${item.status==='pending'?`<button class="btn sm rd" onclick="_epBatch.splice(${i},1);renderEpBatch()">✕</button>`:''}
    </div>`).join('');
}

function clearEpBatch() {
  if(_epBatchRunning) { lg('w','Batch is running - stop it first'); return; }
  _epBatch.length = 0; renderEpBatch();
}

