// Core EPUB translation loop - shared by single-EPUB and batch modes
async function runEpQWithProgress(batchItem, pendingOverride) {
  const mA=I('mdlA').value;
  const sel=[...S.epub.sel];
  const pending = pendingOverride || sel.filter(i=>S.epub.chapters[i]?.status==='pending');
  const totalChaps = pending.length;

  // V6: Terminology extraction pre-pass
  if (I('doTermExtract')?.checked && pending.length > 0 && !batchItem) {
    const sampleChap = S.epub.chapters[pending[0]];
    if (sampleChap?.raw) {
      I('termPanel').style.display = '';
      I('termList').innerHTML = '<div style="color:var(--tx3);font-size:.73rem;padding:.3rem">Extracting terminology…</div>';
      await extractTerminology(sampleChap.raw.slice(0, 3000));
      // Give user a moment to review - they can add terms before translation proceeds
      // (translation starts immediately; they can add terms mid-run too)
    }
  }
  let chapsDone = 0;

  for(let pi=0; pi<pending.length; pi++) {
    const ci = pending[pi];
    const ch = S.epub.chapters[ci];
    // V6: Save previous output for diff view if chapter was already translated
    if (ch.status === 'done' && ch.out) ch.prevOut = ch.out;
    ch.status='running'; renderEpQ(); renderEpList();
    epProgStart(ch.title, pi, totalChaps);
    I('epProgress').style.display='';
    I('epProgress').textContent=`Translating: ${ch.title} (${pi+1}/${totalChaps})`;
    if(batchItem) { batchItem.translatedChaps = chapsDone; renderEpBatch(); }

    try {
      const chunks = chunkText(ch.raw,'A');
      let out='';
      const mB_ep=I('mdlB').value;

      // Claude batch mode: submit full chapter as a single batch job
      if (_provider === 'claude' && I('claudeBatch')?.checked) {
        const bSys = buildTP(ch.raw);
        const bResults = await runClaudeBatch(chunks, bSys, parseFloat(I('ta').value));
        out = bResults.map((r, i) => applyPostProcessing(r, chunks[i])).filter(Boolean).join('\n\n');
      } else if(S.wf==='seq' && mB_ep) {
        // Sequential dual - wire progress into each pass
        out = await runSeqDualEp(ch.raw, chunks, ch.title);
      } else if(S.wf==='seq' && !mB_ep) {
        out = await runSequentialEp(ch.raw, chunks, ch.title);
      } else if(S.wf==='dual') {
        out = await runDual(ch.raw, null, null, null);
      } else {
        out = await runSingleEp(ch.raw, chunks, ch.title);
      }

      ch.out = out; ch.status='done'; S.chunks++; updStats(); saveSt();
      epProgDone();
      chapsDone++;

      // Translate chapter title
      try {
        const titleKo = ch.title;
        if(/[가-힯ㄱ-㆏]/.test(titleKo)) {
          const tSys = '/no_think\nTranslate this Korean chapter title to English. Output ONLY the English title. One line, no punctuation changes, no explanation.';
          ch.titleEn = await chat(mA, tSys, titleKo, 0.1);
          if(!ch.titleEn?.trim()) ch.titleEn = titleKo;
        } else {
          ch.titleEn = titleKo;
        }
      } catch(e) { ch.titleEn = ch.title; }

      lg('o', `${ch.title} → ${ch.titleEn||ch.title} done`);
    } catch(e) {
      ch.status='err'; ch.err=e.message;
      lg('e', ch.title+': '+e.message);
      epProgDone();
    }
    renderEpQ(); renderEpList();
  }
  I('epProgress').textContent=`✓ ${chapsDone} chapter(s) translated`;
}

// EP-specific workflow wrappers that report chunk progress
async function runSingleEp(raw, chunks, title) {
  const mA=I('mdlA').value, tA=parseFloat(I('ta').value), delay=parseInt(I('cd').value);
  const skipAudit = I('skipAudit')?.checked;
  let rawTranslation='', contextTailEp='';
  for(let i=0;i<chunks.length;i++) {
    epProgChunk(i, chunks.length, 'Translating');
    const _c = cleanChunkForModel(chunks[i]);
    const _ctxEp=getContextTail(contextTailEp||'');
    const out = await chatWithRetry(mA, buildTP(_c), withContext(_c,_ctxEp), tA, null, _c);
    reqLogAdd(mA, _c.slice(0,400), out.slice(0,400));
    const _ppOut=applyPostProcessing(out, chunks[i]);
    rawTranslation += (i>0?'\n\n':'') + _ppOut;
    contextTailEp=_ppOut;
    epProgChunkDone(); _updateEpEta(chunks.length-i-1);
    if(delay>0 && i<chunks.length-1) await sleep(delay);
  }
  if(skipAudit || !I('mdlG').value) return rawTranslation;
  const mG=I('mdlG').value, tG=parseFloat(I('tg').value);
  const transChunks=chunkText(rawTranslation,'G');
  let audited='';
  for(let i=0;i<transChunks.length;i++) {
    epProgChunk(i, transChunks.length, 'Auditing');
    const userMsg=`Korean original:\n${chunks[i]||''}\n\n---\n\nEnglish translation to audit:\n${transChunks[i]||''}`;
    const out = await chatWithRetry(mG, buildAuditP(chunks[i]||''), userMsg, tG, null, transChunks[i]||'');
    reqLogAdd(mG, transChunks[i].slice(0,400), out.slice(0,400));
    audited += (i>0?'\n\n':'') + out;
    epProgChunkDone(); _updateEpEta(transChunks.length-i-1);
    if(delay>0 && i<transChunks.length-1) await sleep(delay);
  }
  return audited.trim() || rawTranslation;
}

async function runSeqDualEp(raw, chunks, title) {
  const mA=I('mdlA').value, mB=I('mdlB').value, mG=I('mdlG').value;
  const tA=parseFloat(I('ta').value), tB=parseFloat(I('tb').value), tG=parseFloat(I('tg').value);
  const delay=parseInt(I('cd').value);
  let rawA='';
  for(let i=0;i<chunks.length;i++) {
    epProgChunk(i, chunks.length, 'Pass A');
    const _ca=cleanChunkForModel(chunks[i]); const _ctxA=getContextTail(ctxTailA||''); const out=await chatWithRetry(mA, buildTP(_ca), withContext(_ca,_ctxA), tA, null, _ca);
    const out_ppA=applyPostProcessing(out,chunks[i]);
    reqLogAdd(mA, _ca.slice(0,400), out_ppA.slice(0,400));
    rawA+=(i>0?'\n\n':'')+out_ppA;
    ctxTailA=out_ppA;
    epProgChunkDone(); if(delay>0&&i<chunks.length-1) await sleep(delay);
  }
  let rawB='';
  for(let i=0;i<chunks.length;i++) {
    epProgChunk(i, chunks.length, 'Pass B');
    const _cb=cleanChunkForModel(chunks[i]); const _ctxB=getContextTail(ctxTailB||''); const out=await chatWithRetry(mB, buildTP(_cb), withContext(_cb,_ctxB), tB, null, _cb);
    const out_ppB=applyPostProcessing(out,chunks[i]);
    reqLogAdd(mB, _cb.slice(0,400), out_ppB.slice(0,400));
    rawB+=(i>0?'\n\n':'')+out_ppB;
    ctxTailB=out_ppB;
    epProgChunkDone(); if(delay>0&&i<chunks.length-1) await sleep(delay);
  }
  if(I('skipAudit')?.checked || !mG) return rawA;
  const chunksA=chunkText(rawA,'A'), chunksB=chunkText(rawB,'B');
  let final=''; S.arbData=[];
  for(let i=0;i<Math.max(chunksA.length,chunksB.length);i++) {
    epProgChunk(i, chunksA.length, 'Arbitrating');
    const sents=await arbitrateWithStructure(chunksA[i]||'', chunksB[i]||'', mG, tG);
    S.arbData.push(...sents);
    final+=(i>0?'\n\n':'')+joinArbitratedSents(sents);
    epProgChunkDone();
  }
  return final.trim() || rawA;
}

async function runSequentialEp(raw, chunks, title) {
