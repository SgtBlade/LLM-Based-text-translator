// Count words in a string, language-agnostic
// For CJK: count characters (each ~= 1 word unit)
// For Latin scripts: count whitespace-delimited tokens
function wordCount(text) {
  if(!text) return 0;
  const cjk = (text.match(/[㐀-鿿가-힯ぁ-ヿ]/g)||[]).length;
  const latin = (text.match(/\S+/g)||[]).length;
  // If >30% CJK, treat as CJK text (count chars)
  return cjk > latin * 0.3 ? cjk : latin;
}

// Detect common assistant-mode contamination in translated text
function detectAssistantMode(text) {
  const issues = [];
  // Markdown headers at start of lines
  if(/^#{1,3}\s/m.test(text))
    issues.push('Contains markdown headers (###) - model may have gone into assistant mode');
  // Numbered option lists (1. ... 2. ...)
  if(/^\s*[1-9]\.\s+\w/m.test(text) && /^\s*[2-9]\.\s+\w/m.test(text))
    issues.push('Contains numbered lists - model may have offered options instead of translating');
  // "Here is the translation" preamble
  if(/^(here is|here's|below is|the following is).{0,30}translation/im.test(text.slice(0,200)))
    issues.push('Starts with translation preamble ("Here is the translation:") - model did not follow instructions');
  // Horizontal rules
  if(/^---+$/m.test(text))
    issues.push('Contains markdown horizontal rules (---) - possible assistant mode output');
  // "Step X" or "Next steps"
  if(/next steps?|step [0-9]/i.test(text.slice(0, 500)))
    issues.push('Contains "Next steps" / "Step N" - model produced a guide instead of translation');
  // Original Korean mixed in heavily (>15% CJK in supposedly translated text)
  const cjkRatio = (text.match(/[가-힯㐀-鿿]/g)||[]).length / Math.max(1, text.length);
  if(cjkRatio > 0.15)
    issues.push(`High CJK character ratio (${(cjkRatio*100).toFixed(1)}%) - model may have returned untranslated text`);
  return issues;
}

// Main validation function
// Returns a validation report object
async function validateEpubOutput(origChapters, translatedChapters, origMeta, outMeta) {
  const report = {
    passed: true,
    metaIssues: [],
    chapResults: [],
    summary: { total: 0, ok: 0, warn: 0, err: 0 }
  };

  // ── Metadata checks ──
  if(origMeta && outMeta) {
    if(origMeta.title && outMeta.title && !outMeta.title.includes(origMeta.title.slice(0,10)))
      report.metaIssues.push({ sev:'warn', msg:'Title changed: "'+origMeta.title+'" → "'+outMeta.title+'"' });
    if(origMeta.author !== outMeta.author)
      report.metaIssues.push({ sev:'warn', msg:'Author changed: "'+origMeta.author+'" → "'+outMeta.author+'"' });
  }
  const origCount = origChapters.length;
  const transCount = translatedChapters.length;
  if(origCount !== transCount)
    report.metaIssues.push({ sev:'warn', msg:`Chapter count mismatch: original has ${origCount}, output has ${transCount}` });

  // ── Per-chapter checks ──
  for(const ch of translatedChapters) {
    const result = { title: ch.title, issues: [], severity: 'ok' };
    report.summary.total++;

    const srcWords = wordCount(ch.raw || '');
    const outWords = wordCount(ch.out || '');
    const ratio    = srcWords > 0 ? outWords / srcWords : 0;

    result.srcWords = srcWords;
    result.outWords = outWords;
    result.ratio    = ratio;

    // Empty output
    if(!ch.out || !ch.out.trim()) {
      result.issues.push({ sev:'err', msg:'Output is empty - chapter will use original text in EPUB' });
      result.severity = 'err';
    } else {
      // Word count ratio check
      // Floor: output < 8% of source = almost certainly empty/broken
      if(srcWords > 50 && ratio < 0.08) {
        result.issues.push({ sev:'err', msg:`Output suspiciously short: ${outWords} words vs ${srcWords} source words (ratio ${(ratio*100).toFixed(1)}%) - translation may have failed` });
        result.severity = 'err';
      }
      // Ceiling: output > 800% of source = model went into assistant mode
      else if(ratio > 8.0) {
        result.issues.push({ sev:'warn', msg:`Output suspiciously long: ${outWords} words vs ${srcWords} source words (ratio ${(ratio*100).toFixed(1)}%) - model may have added extra content` });
        result.severity = result.severity === 'err' ? 'err' : 'warn';
      }
      // Moderate warning: output < 20% of source (might just be a short chapter being summarized)
      else if(srcWords > 100 && ratio < 0.20) {
        result.issues.push({ sev:'warn', msg:`Output shorter than expected: ${outWords} words vs ${srcWords} source words (ratio ${(ratio*100).toFixed(1)}%)` });
        result.severity = result.severity === 'err' ? 'err' : 'warn';
      }

      // Identity check: is output same as input? (model returned untranslated text)
      if(ch.out && ch.raw && ch.out.trim().slice(0,100) === ch.raw.trim().slice(0,100)) {
        result.issues.push({ sev:'err', msg:'Output appears identical to source - model may have returned untranslated text' });
        result.severity = 'err';
      }

      // Assistant mode detection
      const asmIssues = detectAssistantMode(ch.out || '');
      asmIssues.forEach(m => {
        result.issues.push({ sev:'warn', msg: m });
        if(result.severity !== 'err') result.severity = 'warn';
      });
    }

    if(result.severity === 'ok') report.summary.ok++;
    else if(result.severity === 'warn') { report.summary.warn++; report.passed = false; }
    else { report.summary.err++; report.passed = false; }

    report.chapResults.push(result);
  }
  return report;
}

function renderValReport(report) {
  const el = I('valReport');
  if(!el) return;
  el.style.display = '';

  const overallSev = report.summary.err > 0 ? 'err' : report.summary.warn > 0 ? 'warn' : 'ok';
  const overallLabel = overallSev === 'ok' ? '✓ All checks passed' : overallSev === 'warn' ? '⚠ Warnings found' : '✗ Issues found';
  const overallColor = overallSev === 'ok' ? 'var(--gn)' : overallSev === 'warn' ? '#ffc107' : 'var(--rd)';

  const metaHtml = report.metaIssues.length
    ? report.metaIssues.map(i => `<div class="val-issue val-issue-${i.sev}">⚠ ${escXml(i.msg)}</div>`).join('')
    : '<div class="val-issue val-issue-o">✓ Metadata matches original</div>';

  const chapHtml = report.chapResults.map((r, ri) => {
    const badge = r.severity === 'ok'
      ? '<span class="val-badge val-ok">✓ ok</span>'
      : r.severity === 'warn'
        ? '<span class="val-badge val-warn">⚠ warn</span>'
        : '<span class="val-badge val-err">✗ error</span>';
    const stat = r.srcWords !== undefined
      ? `<span class="val-chap-stat">${r.srcWords}→${r.outWords} words (${r.ratio !== undefined?(r.ratio*100).toFixed(0)+'%':'?'})</span>`
      : '';
    // Retry button: only shown on warn/err chapters
    const retryBtn = r.severity !== 'ok'
      ? `<button class="btn sm" id="val-retry-${ri}"
           onclick="valRetryChapter(${ri},'${r.title.replace(/'/g,"\'")}')"
           title="Re-translate this chapter and compare result vs current output"
           style="margin-left:4px;flex-shrink:0">↻ Retry</button>`
      : '';
    const issues = r.issues.length
      ? r.issues.map(i => `<div class="val-issue val-issue-${i.sev}" style="margin:2px 0 0 1.5rem">${escXml(i.msg)}</div>`).join('')
      : '';
    return `<div class="val-chap-row" style="flex-wrap:wrap">
      <span class="val-chap-name">${escXml(r.title)}</span>
      <div style="display:flex;align-items:center;gap:4px;margin-left:auto">${stat}${badge}${retryBtn}</div>
    </div>${issues}`;
  }).join('');

  el.innerHTML = `
    <div class="val-report">
      <div class="val-report-hdr">
        <span>📋 Validation Report</span>
        <span style="color:${overallColor};font-size:.72rem">${overallLabel} · ${report.summary.ok} ok, ${report.summary.warn} warn, ${report.summary.err} err</span>
        <button class="btn sm" onclick="I('valReport').style.display='none'">✕</button>
      </div>
      <div class="val-section">
        <div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--tx3);margin-bottom:5px">Metadata</div>
        ${metaHtml}
      </div>
      <div class="val-section">
        <div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;color:var(--tx3);margin-bottom:5px">Chapters (${report.chapResults.length})</div>
        ${chapHtml}
      </div>
      ${!report.passed ? `<div class="val-section" style="font-size:.71rem;color:var(--tx3)">
        ⚠ Flagged chapters still included in EPUB. Use ↻ Retry next to any chapter to re-translate and compare the result before re-downloading.
      </div>` : ''}
    </div>`;
}

// Retry a single chapter from the validation report and open diff view when done
async function valRetryChapter(reportIdx, chapTitle) {
  // Find the chapter in S.epub.chapters by title
  const chapIdx = S.epub.chapters.findIndex(
    c => c.title === chapTitle || (c.titleEn && c.titleEn === chapTitle)
  );
  if (chapIdx === -1) { lg('w', `Cannot find chapter "${chapTitle}" for retry`); return; }

  const ch = S.epub.chapters[chapIdx];
  const btn = I(`val-retry-${reportIdx}`);
  if (btn) { btn.disabled = true; btn.textContent = '…running'; }

  // Save current output as prevOut so diff view can compare
  if (ch.out) ch.prevOut = ch.out;

  // Mark as pending and translate just this chapter
  ch.status = 'pending';
  renderEpQ(); renderEpList();

  lg('i', `Validation retry: re-translating "${ch.title}"…`);
  try {
    await runEpQWithProgress(null, [chapIdx]);
    lg('o', `Retry complete: "${ch.title}"`);

    // Open diff view automatically if we have both versions
    if (ch.prevOut && ch.out && ch.out !== ch.prevOut) {
      showChapterDiff(chapIdx);
      // Scroll diff panel into view
      const dp = I('diffPanel');
      if (dp) dp.scrollIntoView({ behavior: 'smooth', block: 'start' });
      // Update the retry button to show diff is open
      if (btn) { btn.textContent = '↻ Retry'; btn.disabled = false; }
    } else if (ch.out === ch.prevOut) {
      lg('i', `Retry produced identical output - consistent result`);
      if (btn) { btn.textContent = '= Same'; btn.disabled = false; }
    } else {
      if (btn) { btn.textContent = '↻ Retry'; btn.disabled = false; }
    }
    renderEpQ(); renderEpList();
  } catch(e) {
    lg('e', `Retry failed: ${e.message}`);
    if (btn) { btn.textContent = '✗ Error'; btn.disabled = false; }
  }
}

