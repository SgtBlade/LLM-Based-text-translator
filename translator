}
async function wt_ocrTess(r) {
  if(!window.Tesseract) throw new Error('Tesseract.js not loaded');
  const tmp=document.createElement('canvas'); tmp.width=r.w; tmp.height=r.h;
  const tc=tmp.getContext('2d'); tc.putImageData(S.wt.orig,-r.x,-r.y);
  const {data:{text}}=await Tesseract.recognize(tmp,'kor',{logger:m=>{if(m.status==='recognizing text')wt_lg('i',`OCR ${Math.round(m.progress*100)}%`);}});
  return text.trim();
}
async function wt_ocrLLM(r,model) {
  const tmp=document.createElement('canvas'); tmp.width=r.w; tmp.height=r.h;
  const tc=tmp.getContext('2d'); tc.putImageData(S.wt.orig,-r.x,-r.y);
  const b64=tmp.toDataURL('image/png').split(',')[1];
  const resp=await fetch(I('obase').value+'/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({model,stream:false,messages:[{role:'system',content:'Extract all Korean text from this speech bubble image. Output ONLY the Korean text, nothing else.'},{role:'user',content:[{type:'image_url',image_url:{url:`data:image/png;base64,${b64}`}},{type:'text',text:'Extract Korean text.'}]}]})});
  const d=await resp.json(); return (d.message?.content||'').trim();
}

