async function runQ() {
  const mA=I('mdlA').value; if(!mA){lg('w','No model A');return;}
  I('qRunBtn').disabled=true;
  for(const item of S.queue) {
    if(item.status!=='pending') continue;
    item.status='running'; renderQ();
    try {
      const mB_q=I('mdlB').value;
      const workflowFn = () => {
        if(item.wf==='seq'&&mB_q)       return runSeqDual(item.text,null,null,null,null);
        else if(item.wf==='seq'&&!mB_q) return runSequential(item.text,null,null,null);
        else if(item.wf==='dual')        return runDual(item.text,null,null,null);
        else                             return runSingle(item.text,null,null);
      };
      const {out, flagged} = await translateWithDuplicateCheck(workflowFn, item.name);
      item.out=out; item.status='done'; item.flagged=flagged; S.chunks++; updStats(); saveSt();
    } catch(e){item.status='err';item.err=e.message;lg('e',item.name+': '+e.message);}
    renderQ();
  }
  I('qRunBtn').disabled=false;
  const completedItems = S.queue.filter(q=>q.status==='done' && q.out);
  const flaggedItems = completedItems.filter(q=>q.flagged);
  lg('o',`Queue complete - ${completedItems.length} item(s) translated${flaggedItems.length?` · ⚠ ${flaggedItems.length} flagged for duplicate review`:''} · use ↓ buttons or Download all to save`);
  renderQ();
}
function renderQ() {
  const el=I('qlist');
  if(!S.queue.length){el.innerHTML='<div class="empty"><div class="emico">≡</div>No items.</div>';return;}
  const doneCount=S.queue.filter(q=>q.status==='done').length;
  const header=doneCount>1
    ?`<div style="display:flex;justify-content:flex-end;margin-bottom:6px">
        <button class="btn sm" onclick="dlQueueAll()" title="Download all translated items as .txt files">↓ Download all (${doneCount})</button>
      </div>`
    :'';
  el.innerHTML=header+S.queue.map((item,i)=>`
    <div class="qi">
      <div class="qd q-${item.status==='pending'?'p':item.status==='running'?'r':item.status==='done'?'d':'e'}"></div>
      <div class="qn">${item.name}${item.flagged?' <span style="color:var(--rd,#e55)" title="Possible duplicate content - review manually">⚠</span>':''} <span style="color:var(--tx3);font-size:.62rem">[${item.wf||'?'}] ~${chunkText(item.text).length} chunks</span></div>
      <div class="qm">${item.status==='err'?'⚠ '+item.err:item.flagged?'done (⚠ flagged)':item.status}</div>
      ${item.status==='done'?`
        <button class="btn sm" onclick="dlQueueItem(${i})" title="Download as .txt">↓</button>
        <button class="btn sm" onclick="navigator.clipboard.writeText(S.queue[${i}].out)" title="Copy to clipboard">⎘</button>`:''}
      <button class="btn sm rd" onclick="S.queue.splice(${i},1);renderQ();I('qbg').textContent=S.queue.length">✕</button>
    </div>`).join('');
}

function dlQueueItem(i) {
  const item = S.queue[i];
  if (!item?.out) return;
  const safeName = item.name.replace(/\.txt$/i,'').replace(/[^a-z0-9\-_\u3131-\uD7A3]/gi,'_').slice(0,80);
  dlBlob(item.out, safeName + '_translated.txt', 'text/plain;charset=utf-8');
  lg('o', 'Downloaded: ' + item.name);
}

function dlQueueAll() {
  const done = S.queue.filter(q => q.status === 'done' && q.out);
  if (!done.length) { lg('w', 'No completed items to download'); return; }
  // Stagger downloads slightly so the browser doesn't block them
  done.forEach((item, idx) => {
    setTimeout(() => {
      const safeName = item.name.replace(/\.txt$/i,'').replace(/[^a-z0-9\-_\u3131-\uD7A3]/gi,'_').slice(0,80);
      dlBlob(item.out, safeName + '_translated.txt', 'text/plain;charset=utf-8');
    }, idx * 300);
  });
  lg('o', `Downloading ${done.length} translated file(s)…`);
}
function clearQ(){S.queue=[];renderQ();I('qbg').textContent=0;}

